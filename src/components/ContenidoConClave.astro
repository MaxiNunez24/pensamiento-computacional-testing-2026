---
/**
 * La puerta de /casos/: sin la clave, la página no tiene nada que mostrar.
 *
 * ─────────────────────── POR QUÉ NO ALCANZA CON ESCONDER ────────────────────
 *
 * Una clave delante de una página estática no protege nada: el texto viajó con
 * el HTML y se lee con Ctrl+U. Por eso acá el contenido **no se publica**. La
 * página sale vacía, y lo que se ve llega del Worker recién cuando alguien
 * escribe la clave. Es lo mismo que hacemos con las respuestas del cuestionario.
 *
 * El contenido vive en el KV del Worker, bajo la clave `casos`. En la máquina
 * del profe queda `contenido-privado/casos.json`, que está fuera de Git.
 *
 * ────────────────────────────── QUÉ ENTREGA ─────────────────────────────────
 *
 *   { pasos: [...],            → van al CircuitoInfo   (evento circuito:datos)
 *     casos: [...],            → van al MapaCasos      (evento casos:datos)
 *     html: { antes, entre, despues } }  → los textos, a sus huecos
 *
 * Los componentes ya sabían dibujarse solos con los datos que les llegan: lo
 * único nuevo es de dónde vienen.
 */
import { EMAIL_PROFE } from '../scripts/editor-comun';

const WORKER = 'https://cuestionario.maxinunez434.workers.dev';
const ORIGEN_OK = 'https://maxinunez24.github.io';
---

<section class="puerta" data-puerta data-worker={WORKER} data-origen={ORIGEN_OK} data-email={EMAIL_PROFE}>
  <p class="puerta__aviso" data-aviso-origen hidden></p>

  <form class="puerta__form" data-entrar>
    <label class="puerta__etiqueta" for="puerta-clave">🔒 Clave de lectura</label>
    <p class="puerta__ayuda">
      Acá está el mapa de <strong>cómo trabaja cada persona del CFP</strong>, armado por el curso
      con lo que nos contaron. Se abre con la clave que te pasamos. <strong>No se guarda</strong>:
      se escribe cada vez y se va al cerrar la pestaña.
    </p>
    <div class="puerta__fila">
      <input class="puerta__input" type="password" id="puerta-clave" data-clave
             autocomplete="off" placeholder="la clave del curso" />
      <button class="puerta__btn puerta__btn--ok" type="submit">Entrar</button>
    </div>
    <p class="puerta__estado" data-estado></p>
  </form>

  <button type="button" class="puerta__btn puerta__salir" data-salir hidden>🔒 Cerrar</button>
</section>

<script>
  document.querySelectorAll('[data-puerta]').forEach((raiz) => {
    const $ = (s: string) => raiz.querySelector(s) as HTMLElement | null;
    const WORKER = (raiz as HTMLElement).dataset.worker!;
    const ORIGEN_OK = (raiz as HTMLElement).dataset.origen!;

    /* La clave vive en esta variable y en ningún otro lado: ni localStorage ni
       sessionStorage. Cerrar la pestaña la borra. */
    let clave = '';

    if (location.origin !== ORIGEN_OK) {
      const aviso = $('[data-aviso-origen]')!;
      aviso.hidden = false;
      aviso.innerHTML =
        '⚠️ Esto solo funciona desde el <strong>sitio publicado</strong>. El Worker acepta pedidos ' +
        'de <code>' + ORIGEN_OK + '</code> y nada más, así que desde <code>' + location.origin +
        '</code> el navegador los frena por CORS. No es la clave: es el origen.';
    }

    const huecos = () => ({
      antes: document.querySelector('[data-privado="antes"]') as HTMLElement | null,
      entre: document.querySelector('[data-privado="entre"]') as HTMLElement | null,
      despues: document.querySelector('[data-privado="despues"]') as HTMLElement | null,
    });

    /* ── Las respuestas del equipo directivo ────────────────────────────
       Los campos vienen adentro del HTML que manda el Worker. Acá se les
       engancha el guardado y la forma de que vuelvan.

       No se envían solas a propósito: se copian y se pegan en un mail. Un
       botón que "manda" sin que se vea qué mandó es justo lo que no queremos
       en una página que trata sobre el trabajo de otras personas. */
    const LS_RESP = 'pc_casos_respuestas';

    function guardadas(): Record<string, string> {
      try { return JSON.parse(localStorage.getItem(LS_RESP) || '{}'); } catch { return {}; }
    }

    function textoDeRespuestas() {
      const campos = [...document.querySelectorAll('[data-respuesta]')] as HTMLTextAreaElement[];
      const lineas = ['RESPUESTAS — Cómo trabaja cada uno (CFP 401)', ''];
      let hay = 0;
      campos.forEach((c) => {
        const valor = c.value.trim();
        if (!valor) return;
        hay++;
        const etiqueta = c.closest('label')?.querySelector('.resp-dir__et')?.textContent || c.dataset.respuesta;
        lineas.push('── ' + etiqueta, valor, '');
      });
      return hay ? lineas.join('\n') : '';
    }

    function prepararRespuestas() {
      const campos = [...document.querySelectorAll('[data-respuesta]')] as HTMLTextAreaElement[];
      if (!campos.length) return;
      const previas = guardadas();

      campos.forEach((c) => {
        const id = c.dataset.respuesta!;
        if (previas[id]) c.value = previas[id];
        c.addEventListener('input', () => {
          const todas = guardadas();
          todas[id] = c.value;
          try { localStorage.setItem(LS_RESP, JSON.stringify(todas)); } catch { /* sin guardado */ }
        });
      });

      // La barra para que las respuestas vuelvan.
      //
      // El mailto ya trae las respuestas adentro, así que con un clic se abre
      // el correo con todo escrito. Pero NO se puede confiar solo en eso: si
      // la máquina no tiene programa de correo configurado —que es lo normal
      // en una PC de oficina— el clic no hace absolutamente nada y la persona
      // se queda mirando la pantalla. Por eso la dirección está también a la
      // vista, y el botón de copiar es el camino principal.
      const email = (raiz as HTMLElement).dataset.email || '';
      const barra = document.createElement('div');
      barra.className = 'resp-dir__barra';
      barra.innerHTML =
        '<button type="button" class="puerta__btn puerta__btn--ok" data-copiar-resp>📋 Copiar mis respuestas</button>' +
        '<a class="puerta__btn" data-mail href="#">✉️ Abrir mi correo</a>' +
        '<span class="resp-dir__estado" data-estado-resp></span>' +
        '<p class="resp-dir__mail">Si el botón no abre nada, tu computadora no tiene un programa de ' +
        'correo configurado: copiá las respuestas y mandalas a <a href="mailto:' + email + '">' +
        email + '</a></p>';
      campos[campos.length - 1].closest('label')!.after(barra);

      const estado = barra.querySelector('[data-estado-resp]') as HTMLElement;
      const enlace = barra.querySelector('[data-mail]') as HTMLAnchorElement;
      const asunto = encodeURIComponent('Correcciones — Cómo trabaja cada uno (CFP 401)');

      /* El cuerpo del mailto se arma con lo contestado hasta ese momento. Va
         recortado: hay programas de correo que cortan las URL largas, y una
         respuesta cortada por la mitad es peor que ninguna. */
      const actualizarMail = () => {
        const texto = textoDeRespuestas();
        const cuerpo = texto.length > 1500
          ? texto.slice(0, 1500) + '\n\n[…] (quedó cortado: pegá el resto con 📋 Copiar mis respuestas)'
          : texto;
        enlace.href = 'mailto:' + email + '?subject=' + asunto +
                      (cuerpo ? '&body=' + encodeURIComponent(cuerpo) : '');
      };
      actualizarMail();
      campos.forEach((c) => c.addEventListener('input', actualizarMail));

      barra.querySelector('[data-copiar-resp]')!.addEventListener('click', async () => {
        const texto = textoDeRespuestas();
        if (!texto) { estado.textContent = 'Todavía no escribiste ninguna respuesta.'; return; }
        try {
          await navigator.clipboard.writeText(texto);
          estado.textContent = '✅ Copiadas. Ahora pegalas en el mail.';
        } catch {
          estado.textContent = 'No pude copiar: seleccioná el texto de los campos a mano.';
        }
      });
    }

    /* ── El índice de la derecha ────────────────────────────────────────
       Starlight lo arma al cargar la página, cuando acá todavía no hay nada:
       por eso quedaba solo "Sinopsis". Se completa con los títulos que trae el
       contenido, para poder saltar directo a las preguntas o a las decisiones
       abiertas en vez de bajar a dedo por veintitantos casos. */
    function armarIndice() {
      const titulos = [...document.querySelectorAll('.sl-markdown-content h2[id], .sl-markdown-content h3[id]')]
        .filter((h) => (h as HTMLElement).innerText.trim());
      document.querySelectorAll('starlight-toc, mobile-starlight-toc').forEach((toc) => {
        const lista = toc.querySelector('ul');
        if (!lista) return;
        lista.querySelectorAll('[data-del-contenido]').forEach((x) => x.remove());
        const modelo = lista.querySelector('li');
        titulos.forEach((titulo) => {
          const prof = titulo.tagName === 'H3' ? 1 : 0;
          const li = modelo
            ? (modelo.cloneNode(true) as HTMLElement)
            : document.createElement('li');
          li.dataset.delContenido = '';
          li.style.setProperty('--depth', String(prof));
          const a = li.querySelector('a') || document.createElement('a');
          a.setAttribute('href', '#' + titulo.id);
          a.style.setProperty('--depth', String(prof));
          const span = a.querySelector('span');
          const texto = (titulo as HTMLElement).innerText.replace(/\s*Sección titulada.*$/s, '').trim();
          if (span) span.textContent = texto; else a.textContent = texto;
          if (!li.contains(a)) li.appendChild(a);
          lista.appendChild(li);
        });
      });
    }

    function repartir(datos: any) {
      const h = huecos();
      (['antes', 'entre', 'despues'] as const).forEach((donde) => {
        const caja = h[donde];
        if (caja) caja.innerHTML = (datos.html && datos.html[donde]) || '';
      });
      prepararRespuestas();
      armarIndice();
      document.querySelector('[data-circuito]')
        ?.dispatchEvent(new CustomEvent('circuito:datos', { detail: datos.pasos || [] }));
      document.querySelector('[data-casos]')
        ?.dispatchEvent(new CustomEvent('casos:datos', { detail: { casos: datos.casos || [] } }));
    }

    function vaciar() {
      const h = huecos();
      Object.values(h).forEach((caja) => { if (caja) caja.innerHTML = ''; });
      document.querySelectorAll('[data-del-contenido]').forEach((x) => x.remove());
      document.querySelector('[data-circuito]')
        ?.dispatchEvent(new CustomEvent('circuito:datos', { detail: [] }));
      document.querySelector('[data-casos]')
        ?.dispatchEvent(new CustomEvent('casos:datos', { detail: { casos: [] } }));
    }

    $('[data-entrar]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const est = $('[data-estado]')!;
      clave = ($('[data-clave]') as HTMLInputElement).value.trim();
      if (!clave) return;
      est.textContent = 'Buscando…';
      try {
        const r = await fetch(WORKER + '/casos', { headers: { 'X-Clave': clave } });
        if (r.status === 401) { est.textContent = 'Esa clave no es. Probá de nuevo.'; return; }
        if (r.status === 404) { est.textContent = 'El Worker todavía no tiene el contenido cargado.'; return; }
        if (r.status === 503) { est.textContent = 'El Worker no tiene CLAVE_DOCENTE configurada.'; return; }
        if (!r.ok) { est.textContent = 'El Worker contestó ' + r.status + '.'; return; }
        repartir(await r.json());
        est.textContent = '';
        ($('[data-entrar]') as HTMLElement).hidden = true;
        $('[data-salir]')!.hidden = false;
      } catch {
        est.textContent = 'No se pudo hablar con el Worker. ¿Hay internet?';
      }
    });

    /* Cerrar borra la clave Y todo lo traído: si esto queda abierto en la
       máquina del aula, que no quede nada a la vista. */
    $('[data-salir]')!.addEventListener('click', () => {
      clave = '';
      vaciar();
      ($('[data-clave]') as HTMLInputElement).value = '';
      ($('[data-entrar]') as HTMLElement).hidden = false;
      $('[data-salir]')!.hidden = true;
      $('[data-estado]')!.textContent = '';
    });
  });
</script>
