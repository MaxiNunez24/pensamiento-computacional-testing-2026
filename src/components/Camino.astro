---
/**
 * El camino del curso: las clases en el orden en que se dan.
 *
 * El menú lateral está ordenado por BLOQUES, que es como se busca algo cuando
 * ya lo viste ("¿dónde estaba lo de diccionarios?"). Pero para el que va
 * avanzando, ese orden no dice por dónde seguir. Esta página es la otra vista:
 * el camino, numerado, con cuánto lleva hecho de cada clase.
 *
 * Los totales NO se escriben a mano: se cuentan de los propios .mdx al
 * construir el sitio. Así el día que se agregue un ejercicio, el número
 * acompaña solo — una lista de totales escrita a mano se desactualiza en dos
 * semanas y después miente.
 *
 * También lo usan las portadas de "Para ir más allá" y de Páginas web, con sus
 * propias etapas. Las páginas fuera de clases/ van con `ruta`.
 */
import { idEjercicio } from '../scripts/id-ejercicio';
import CaminoParada from './CaminoParada.astro';

interface Parada {
  /** Una página de clases/ */
  clase?: string;
  /** Una página de otra carpeta, como 'web/catalogo' */
  ruta?: string;
  nombre: string;
  /** vista | ahora | viene | optativa | preparacion */
  estado?: string;
  nota?: string;
}
/** Clases que van juntas adentro de una etapa: se pliegan y tienen su total. */
interface Grupo {
  nombre: string;
  meta: string;
  paradas: Parada[];
}
interface Etapa {
  nombre: string;
  meta: string;
  paradas: (Parada | Grupo)[];
}

const { etapas, titulo = 'El camino del curso' } = Astro.props as {
  etapas: Etapa[];
  titulo?: string;
};

// Los .mdx crudos, para contar los ejercicios de cada clase.
const fuentes = import.meta.glob(['../content/docs/clases/*.mdx', '../content/docs/web/*.mdx'], {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const COMPONENTES =
  /<(EjercicioPython|EjercicioWeb|CompletarCodigo|OpcionMultiple|EncontrarElError|OrdenarPasos|EjercicioEficiencia|DiagramaClases|DiagramaLibre|Clasificar|EscribirTest)\b/g;

function fuenteDe(ruta: string): string {
  const clave = Object.keys(fuentes).find((k) => k.endsWith(`/${ruta}.mdx`));
  return clave ? fuentes[clave] : '';
}

// Las animaciones cuentan solo si son lecciones con título (ver Animacion.astro):
// las sueltas son de apoyo, y no tienen nada que "resolver".
const LECCIONES = /<Animacion\b[^>]*\btitulo=/g;

function cuantosEjercicios(ruta: string): number {
  const fuente = fuenteDe(ruta);
  return (fuente.match(COMPONENTES) || []).length + (fuente.match(LECCIONES) || []).length;
}

/* El mini parcial es una sola pieza <Evaluacion> y guarda con `pcp:eval:`, no
   con `pcp:done:`. Contarlo como "0 ejercicios" sería mentira: no tiene
   ejercicios sueltos, tiene una entrega. Se muestra como lo que es. */
function esEvaluacion(ruta: string): boolean {
  return fuenteDe(ruta).includes('<Evaluacion');
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const id = idEjercicio(titulo);

const conDatos = (p: Parada) => {
  const ruta = p.ruta ?? `clases/${p.clase}`;
  return {
    ...p,
    ruta,
    total: p.estado === 'preparacion' ? 0 : cuantosEjercicios(ruta),
    evaluacion: esEvaluacion(ruta),
  };
};
const totalDe = (filas: { total: number }[]) => filas.reduce((n, p) => n + p.total, 0);

const conTotales = etapas.map((e) => ({
  ...e,
  paradas: e.paradas.map((p) => {
    if (!('paradas' in p)) return conDatos(p);
    const paradas = p.paradas.map(conDatos);
    return { ...p, paradas, total: totalDe(paradas) };
  }),
}));
const totalCurso = conTotales
  .flatMap((e) => e.paradas)
  .filter((p) => p.estado !== 'optativa')
  .reduce((n, p) => n + p.total, 0);
---

<div class="camino" id={id} data-camino data-base={base}>

  <div class="camino__resumen">
    <div class="camino__numeros">
      <strong data-hechos>—</strong> de {totalCurso} ejercicios
      <span data-pct></span>
    </div>
    <div class="camino__barra"><div class="camino__barra-fill" data-barra></div></div>
    <p class="camino__mensaje" data-mensaje></p>
  </div>

  {conTotales.map((etapa, i) => (
    <details class="camino__etapa" data-etapa open>
      <summary class="camino__etapa-cabeza">
        <h3 class="camino__etapa-tit">
          <span class="camino__num">{i + 1}</span>
          {etapa.nombre}
          <small>{etapa.meta}</small>
        </h3>
        {totalDe(etapa.paradas) > 0 && (
          <span class="camino__progreso">
            <span class="camino__mini"><span class="camino__mini-fill" data-etapa-mini></span></span>
            <span class="camino__cuenta" data-etapa-cuenta>0/{totalDe(etapa.paradas)}</span>
          </span>
        )}
      </summary>

      <ol class="camino__paradas">
        {etapa.paradas.map((p) => 'paradas' in p ? (
          <li class="camino__grupo">
            <details class="camino__etapa" data-etapa open>
              <summary class="camino__etapa-cabeza">
                <span class="camino__etapa-tit">
                  {p.nombre}
                  <small>{p.meta}</small>
                </span>
                <span class="camino__progreso">
                  <span class="camino__mini"><span class="camino__mini-fill" data-etapa-mini></span></span>
                  <span class="camino__cuenta" data-etapa-cuenta>0/{p.total}</span>
                </span>
              </summary>
              <ol class="camino__paradas">
                {p.paradas.map((clase) => <CaminoParada p={clase} base={base} />)}
              </ol>
            </details>
          </li>
        ) : (
          <CaminoParada p={p} base={base} />
        ))}
      </ol>
    </details>
  ))}
</div>

<script>
  document.querySelectorAll('[data-camino]').forEach((camino) => {
    const base = camino.dataset.base;

    /* Se cuentan las claves `pcp:done:` de cada página. A propósito NO hace
       falta saber los títulos: alcanza con contar las que empiezan con la ruta
       de esa página, así el día que cambie un enunciado la cuenta sigue bien. */
    function resueltosDe(ruta) {
      const prefijo = `pcp:done:${base}/${ruta}/::`;
      let n = 0;
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith(prefijo) && localStorage.getItem(k) === '1') n++;
        }
      } catch { /* sin localStorage: queda todo en cero */ }
      return n;
    }

    function pintar() {
      let hechos = 0;
      let total = 0;
      let primeraSinTerminar = null;

      camino.querySelectorAll('[data-ruta]').forEach((li) => {
        const tot = Number(li.dataset.total) || 0;
        const n = Math.min(resueltosDe(li.dataset.ruta), tot);
        const opcional = li.classList.contains('es-optativa');
        li.dataset.hechos = String(n);

        const cuenta = li.querySelector('[data-cuenta]');
        const mini = li.querySelector('[data-mini]');
        if (cuenta && tot > 0) cuenta.textContent = `${n}/${tot}`;
        if (mini) mini.style.width = tot ? (n / tot) * 100 + '%' : '0%';

        const completa = tot > 0 && n === tot;
        li.classList.toggle('is-completa', completa);
        li.classList.toggle('is-empezada', n > 0 && !completa);

        if (!opcional) {
          hechos += n;
          total += tot;
          if (!completa && tot > 0 && !primeraSinTerminar) primeraSinTerminar = li;
        }
        li.classList.remove('is-aca');
      });

      // "Estás acá": la primera clase sin terminar. Es la respuesta a la
      // pregunta que trae a alguien a esta página.
      if (primeraSinTerminar) primeraSinTerminar.classList.add('is-aca');

      // El total de cada bloque: se ve también con el bloque plegado.
      camino.querySelectorAll('[data-etapa]').forEach((etapa) => {
        // Solo el de su cabeza: adentro puede tener grupos con su propio total.
        const cuenta = etapa.querySelector(':scope > summary [data-etapa-cuenta]');
        if (!cuenta) return;
        const filas = [...etapa.querySelectorAll('[data-ruta]')];
        const hechosEtapa = filas.reduce((suma, li) => suma + Number(li.dataset.hechos), 0);
        const totalEtapa = filas.reduce((suma, li) => suma + Number(li.dataset.total), 0);
        cuenta.textContent = `${hechosEtapa}/${totalEtapa}`;
        etapa.querySelector(':scope > summary [data-etapa-mini]').style.width = (hechosEtapa / totalEtapa) * 100 + '%';
      });

      const pct = total ? Math.round((hechos / total) * 100) : 0;
      camino.querySelector('[data-hechos]').textContent = String(hechos);
      camino.querySelector('[data-pct]').textContent = ` · ${pct}%`;
      camino.querySelector('[data-barra]').style.width = pct + '%';

      const msj = camino.querySelector('[data-mensaje]');
      if (hechos === 0) {
        msj.textContent = 'Todavía no arrancaste. La primera parada está marcada abajo.';
      } else if (pct === 100) {
        msj.textContent = '🎉 Hiciste todo el camino. En serio, todo.';
      } else if (primeraSinTerminar) {
        const nombre = primeraSinTerminar.querySelector('.camino__nombre').textContent;
        msj.textContent = `Seguí por: ${nombre}`;
      }
    }

    pintar();
    // Plegados de entrada, salvo el bloque donde estás: es lo que se viene a
    // buscar. Una sola vez: después, cada bloque queda como lo deje quien mira.
    const aca = camino.querySelector('.is-aca');
    camino.querySelectorAll('[data-etapa]').forEach((etapa) => {
      etapa.open = Boolean(aca) && etapa.contains(aca);
    });
    // Al volver de resolver ejercicios en otra pestaña, se actualiza solo.
    document.addEventListener('visibilitychange', () => { if (!document.hidden) pintar(); });
    window.addEventListener('pageshow', pintar);
  });
</script>
