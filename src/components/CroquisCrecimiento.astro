---
/**
 * Croquis: cómo crece el trabajo cuando crecen los datos.
 *
 * Tres formas, que son las tres que van a encontrar en todo el curso:
 *   · plana    → no importa cuántos datos haya, el costo es el mismo
 *   · derecha  → el doble de datos, el doble de trabajo
 *   · curva    → el doble de datos, CUATRO veces el trabajo
 *
 * La idea del dibujo es que el alumno reconozca la forma de su solución sin
 * tener que calcular nada.
 *
 * Sobre la escala: la primera versión hacía que la curva terminara en 0.98 y la
 * recta en 0.90, o sea que se cruzaban recién en el borde derecho y la curva
 * "mala" parecía apenas peor. Eso contaba mal la historia. Ahora la curva SE VA
 * POR ARRIBA del gráfico bastante antes del final, que es lo que pasa de
 * verdad: no es que sea un poco peor, es que se dispara.
 */
const X0 = 62;
const X1 = 470;
const Y0 = 246; // el piso del gráfico
const Y1 = 34; // el techo

const px = (t: number) => X0 + t * (X1 - X0);
const py = (v: number) => Y0 - v * (Y0 - Y1);

/** Puntos hasta que la línea se sale por el techo (ahí se corta). */
const puntos = (f: (t: number) => number, hasta = 1): string => {
  const out: string[] = [];
  const N = 60;
  for (let i = 0; i <= N; i++) {
    const t = (i / N) * hasta;
    const v = f(t);
    if (v > 1) {
      // Punto exacto donde cruza el techo, para que el corte quede limpio.
      const anterior = f(((i - 1) / N) * hasta);
      const p = (1 - anterior) / (v - anterior);
      const tCruce = ((i - 1 + p) / N) * hasta;
      out.push(`${px(tCruce).toFixed(1)},${py(1).toFixed(1)}`);
      break;
    }
    out.push(`${px(t).toFixed(1)},${py(v).toFixed(1)}`);
  }
  return out.join(' ');
};

// La curva llega al techo al 58% del ancho: de ahí en más ya no entra en la hoja.
const T_FUGA = 0.58;
const fCurva = (t: number) => (t / T_FUGA) ** 2;
const fRecta = (t: number) => t * 0.62;

const plana = puntos(() => 0.06);
const recta = puntos(fRecta);
const curva = puntos(fCurva);

// Dónde termina cada línea, para colgar ahí la etiqueta.
const xFuga = px(T_FUGA);
const yRectaFin = py(fRecta(1));
---

<figure class="croquis">
  <svg viewBox="0 0 520 300" role="img" aria-labelledby="croquis-crec-titulo">
    <title id="croquis-crec-titulo">
      Tres formas en que puede crecer el trabajo de un programa cuando crecen los datos
    </title>

    {/* Ejes */}
    <line x1={X0} y1={Y1 - 8} x2={X0} y2={Y0} class="croquis__eje" />
    <line x1={X0} y1={Y0} x2={X1 + 10} y2={Y0} class="croquis__eje" />
    <text x={X0 - 8} y={Y1 - 14} class="croquis__sub" text-anchor="start">↑ pasos que ejecuta</text>
    <text x={X1 + 10} y={Y0 + 20} class="croquis__sub" text-anchor="end">cantidad de datos →</text>

    {/* Las tres formas */}
    <polyline points={curva} class="croquis__linea croquis__linea--mala" />
    <polyline points={recta} class="croquis__linea croquis__linea--media" />
    <polyline points={plana} class="croquis__linea croquis__linea--buena" />

    {/* La curva no termina: se va de la hoja. La flechita lo dice. */}
    <text x={xFuga + 8} y={Y1 + 4} class="croquis__etiqueta croquis__etiqueta--mala" text-anchor="start">
      ↑ sigue subiendo
    </text>
    <text x={xFuga - 12} y={Y1 + 34} class="croquis__etiqueta croquis__etiqueta--mala" text-anchor="end">
      🐢 una vuelta por cada dato
    </text>

    <text x={X1 - 4} y={yRectaFin - 12} class="croquis__etiqueta croquis__etiqueta--media" text-anchor="end">
      ⚡ una sola vuelta
    </text>
    <text x={X1 - 4} y={py(0.06) - 12} class="croquis__etiqueta croquis__etiqueta--buena" text-anchor="end">
      🏆 sin vueltas
    </text>
  </svg>
  <figcaption>
    Fijate en las dos puntas. Cerca del origen —con pocos datos— las tres formas están casi
    pegadas: por eso una solución cara <strong>parece buena mientras probás con tres elementos</strong>.
    Del otro lado, la roja no termina: <strong>se va del gráfico</strong>. Ahí está el problema, y
    aparece el día que le entran mil datos.
  </figcaption>
</figure>
