---
/** Una fila del camino: una clase, con cuánto lleva hecho. Ver Camino.astro. */
const { p, base } = Astro.props;
---

<li
  class={'camino__parada' + (p.estado ? ' es-' + p.estado : '')}
  data-ruta={p.ruta}
  data-total={String(p.total)}
>
  {/* "preparacion": la clase todavía no tiene página. Va sin link
      (daría 404) y sin total, así no cuenta ni puede ser el "estás
      acá". Está para que se vea lo que falta y el ritmo que hay que
      llevar. Cuando se escribe la clase, se le cambia el estado. */}
  {p.estado === 'preparacion' ? (
    <span class="camino__sin-link">
      <span class="camino__nombre">{p.nombre}</span>
      {p.nota && <span class="camino__nota">{p.nota}</span>}
    </span>
  ) : (
    <a href={`${base}/${p.ruta}/`}>
      <span class="camino__nombre">{p.nombre}</span>
      {p.nota && <span class="camino__nota">{p.nota}</span>}
    </a>
  )}
  <span class="camino__progreso">
    {p.estado === 'preparacion' ? (
      <span class="camino__cuenta camino__cuenta--sin">en preparación</span>
    ) : p.total > 0 ? (
      <>
        <span class="camino__mini"><span class="camino__mini-fill" data-mini></span></span>
        <span class="camino__cuenta" data-cuenta>0/{p.total}</span>
      </>
    ) : (
      <span class="camino__cuenta camino__cuenta--sin">
        {p.evaluacion ? 'se entrega' : 'para leer'}
      </span>
    )}
  </span>
</li>
