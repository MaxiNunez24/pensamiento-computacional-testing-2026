---
/**
 * Maqueta del panel "Source Control" de VS Code, en SVG.
 *
 * Por qué dibujado y no una captura: se adapta al tema claro/oscuro, pesa unos
 * pocos KB, y no hay que rehacerlo cada vez que VS Code cambia de aspecto. Lo
 * que el alumno tiene que reconocer son las LETRAS de estado y dónde vive cada
 * acción, y eso no cambia.
 *
 * Los colores de las letras sí son los literales de VS Code (M ámbar, U verde,
 * D rojo): son la pista visual que van a buscar en la pantalla real.
 *
 * Uso (.mdx):
 *   <PanelGitVSCode
 *     mensaje="Agregar el cartón del bingo"
 *     staged={[{ nombre: 'bingo.py', letra: 'A' }]}
 *     cambios={[{ nombre: 'main.py', letra: 'M' }, { nombre: 'notas.txt', letra: 'U' }]}
 *     resaltar="mas"
 *   />
 */
interface Archivo {
  nombre: string;
  /** M = modificado, U = sin seguimiento, A = agregado (staged), D = borrado */
  letra: 'M' | 'U' | 'A' | 'D';
}
interface Props {
  mensaje?: string;
  staged?: Archivo[];
  cambios?: Archivo[];
  /** Dibuja un aro alrededor de una zona: 'mas' | 'commit' | 'mensaje' | 'sync' */
  resaltar?: 'mas' | 'commit' | 'mensaje' | 'sync';
  titulo?: string;
}

const { mensaje = '', staged = [], cambios = [], resaltar, titulo } = Astro.props;

const COLOR: Record<string, string> = {
  M: '#e2c08d', // modificado
  U: '#73c991', // untracked (nuevo, sin seguimiento)
  A: '#73c991', // added (preparado)
  D: '#c74e39', // borrado
};

// Layout: se calcula acá para que el SVG quede con la altura justa.
const FILA = 26;
const yStaged = staged.length ? 116 : 0;
const yCambios = (staged.length ? yStaged + 18 + staged.length * FILA : 108) + 8;
const alto = yCambios + 18 + cambios.length * FILA + 14;
---

<figure class="panel-vscode">
  {titulo && <figcaption>{titulo}</figcaption>}
  <svg viewBox={`0 0 380 ${alto}`} role="img" aria-label="Panel Source Control de VS Code">
    <!-- marco -->
    <rect x="0" y="0" width="380" height={alto} rx="6" class="pv-fondo" />

    <!-- encabezado -->
    <text x="14" y="24" class="pv-titulo">SOURCE CONTROL</text>
    <!-- botón de sincronizar (push/pull) arriba a la derecha -->
    <g class={resaltar === 'sync' ? 'pv-resaltado' : ''}>
      <circle cx="352" cy="19" r="11" class="pv-iconobg" />
      <path
        d="M347 19a5 5 0 0 1 8.5-3.5M357 19a5 5 0 0 1-8.5 3.5M355.5 12v3.5H352M348.5 26v-3.5H352"
        class="pv-icono"
      />
    </g>

    <!-- caja del mensaje de commit -->
    <g class={resaltar === 'mensaje' ? 'pv-resaltado' : ''}>
      <rect x="14" y="38" width="352" height="30" rx="4" class="pv-input" />
      <text x="24" y="58" class={mensaje ? 'pv-texto' : 'pv-placeholder'}>
        {mensaje || 'Mensaje (Ctrl+Enter para confirmar)'}
      </text>
    </g>

    <!-- botón Commit -->
    <g class={resaltar === 'commit' ? 'pv-resaltado' : ''}>
      <rect x="14" y="76" width="352" height="26" rx="4" class="pv-boton" />
      <text x="190" y="93" class="pv-botontexto" text-anchor="middle">✓ Commit</text>
    </g>

    {staged.length > 0 && (
      <g>
        <text x="14" y={yStaged} class="pv-seccion">STAGED CHANGES</text>
        {staged.map((a, i) => (
          <g>
            <text x="26" y={yStaged + 18 + i * FILA + 12} class="pv-archivo">{a.nombre}</text>
            <text x="356" y={yStaged + 18 + i * FILA + 12} class="pv-letra" fill={COLOR[a.letra]} text-anchor="end">
              {a.letra}
            </text>
          </g>
        ))}
      </g>
    )}

    <text x="14" y={yCambios} class="pv-seccion">CHANGES</text>
    {cambios.map((a, i) => {
      const y = yCambios + 18 + i * FILA + 12;
      return (
        <g>
          <text x="26" y={y} class="pv-archivo">{a.nombre}</text>
          {/* el + que prepara el archivo (equivale a git add) */}
          <g class={resaltar === 'mas' ? 'pv-resaltado' : ''}>
            <text x="336" y={y} class="pv-mas" text-anchor="middle">+</text>
          </g>
          <text x="356" y={y} class="pv-letra" fill={COLOR[a.letra]} text-anchor="end">{a.letra}</text>
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .panel-vscode {
    margin: 1rem 0;
  }
  .panel-vscode figcaption {
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }
  .panel-vscode svg {
    width: 100%;
    max-width: 26rem;
    height: auto;
    font-family: var(--sl-font-mono, monospace);
  }
  /* El panel imita el editor: fondo oscuro en los dos temas, como lo ve el
     alumno (casi todos usan VS Code con el tema oscuro por defecto). */
  .pv-fondo {
    fill: #252526;
    stroke: var(--sl-color-gray-5);
  }
  .pv-titulo {
    fill: #cccccc;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .pv-seccion {
    fill: #9d9d9d;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .pv-archivo {
    fill: #cccccc;
    font-size: 12px;
  }
  .pv-letra {
    font-size: 12px;
    font-weight: 700;
  }
  .pv-mas {
    fill: #cccccc;
    font-size: 15px;
  }
  .pv-input {
    fill: #3c3c3c;
    stroke: #4d4d4d;
  }
  .pv-placeholder {
    fill: #8a8a8a;
    font-size: 11px;
  }
  .pv-texto {
    fill: #e8e8e8;
    font-size: 11px;
  }
  .pv-boton {
    fill: #0e639c;
  }
  .pv-botontexto {
    fill: #ffffff;
    font-size: 12px;
  }
  .pv-iconobg {
    fill: transparent;
  }
  .pv-icono {
    fill: none;
    stroke: #cccccc;
    stroke-width: 1.3;
  }
  /* El aro que señala la zona de la que habla el ejercicio. */
  .pv-resaltado {
    outline: none;
  }
  .pv-resaltado > rect,
  .pv-resaltado > circle {
    stroke: var(--sl-color-accent-high, #4ea1ff);
    stroke-width: 2;
  }
  .pv-resaltado > text {
    fill: var(--sl-color-accent-high, #4ea1ff);
    font-weight: 700;
  }
</style>
