---
/**
 * Renderiza un diagrama Mermaid (de lectura). Para diagramas de clases, flujos, etc.
 *
 * Uso en .mdx:
 *   import Mermaid from '../../../components/Mermaid.astro';
 *   <Mermaid code={`classDiagram\n    Animal <|-- Perro`} />
 *
 * Mermaid se carga de forma perezosa (solo en páginas que tienen diagramas) y
 * adapta el tema (claro/oscuro) al de Starlight.
 */
interface Props {
  code: string;
}
const { code } = Astro.props;
---

<pre class="mermaid" aria-label="Diagrama">{code}</pre>

<script>
  // Solo cargamos Mermaid (que es pesado) si la página tiene algún diagrama.
  async function renderMermaid() {
    const nodos = document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-rendered])');
    if (nodos.length === 0) return;
    const { default: mermaid } = await import('mermaid');
    // Modo oscuro: Starlight setea data-theme cuando es explícito; en "Auto" no lo
    // setea y sigue prefers-color-scheme. Cubrimos ambos casos.
    const attr = document.documentElement.dataset.theme;
    const oscuro = attr
      ? attr === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    mermaid.initialize({ startOnLoad: false, theme: oscuro ? 'dark' : 'default' });
    nodos.forEach((n) => n.setAttribute('data-rendered', ''));
    await mermaid.run({ nodes: nodos });
  }
  if (document.readyState !== 'loading') renderMermaid();
  else document.addEventListener('DOMContentLoaded', renderMermaid);
  document.addEventListener('astro:page-load', renderMermaid);
</script>
