---
/**
 * El plano de la Expo con las muestras activas: /expo/plano/
 *
 * Público y sin el menú del curso: lo miran visitantes, directivos y otros instructores desde el
 * celular. Los stands y los horarios salen de src/data/expo/plano.ts; los horarios de ejemplo se
 * marcan como tales hasta que lleguen los confirmados.
 */
import Expo from '../../layouts/Expo.astro';
import { STANDS, ENTRADA, VISTA, MUESTRAS, DIA, ABRE, CIERRA } from '../../data/expo/plano';

const fondo = import.meta.env.BASE_URL.replace(/\/$/, '') + '/expo/plano-satelite.jpg';
const flechaX = ENTRADA.x + ENTRADA.ancho / 2;

// El nombre de cada stand partido en renglones (en " · ") y con la letra más grande que entra en su
// caja. Los nombres largos se parten en el rótulo de plano.ts: así la letra crece en vez de achicarse.
const rotulos = STANDS.map((s) => {
    const renglones = (s.rotulo ?? s.nombre).split(' · ');
    const largo = s.vertical ? s.alto : s.ancho;
    const corto = s.vertical ? s.ancho : s.alto;
    const masLargo = Math.max(...renglones.map((r) => r.length));
    const tam = Math.max(12, Math.min(24, (largo - 10) / (masLargo * 0.6), (corto - 8) / (renglones.length * 1.2)));
    return { ...s, renglones, tam: Math.round(tam) };
});
const nombreDe = Object.fromEntries(STANDS.map((s) => [s.id, s.nombre]));
const muestras = [...MUESTRAS].sort((a, b) => a.hora.localeCompare(b.hora));
const conHora = muestras.filter((m) => !m.todaLaTarde);
const todaLaTarde = muestras.filter((m) => m.todaLaTarde);
const hayEjemplos = muestras.some((m) => m.ejemplo);
const datos = { stands: STANDS, muestras, dia: DIA, abre: ABRE, cierra: CIERRA };
---

<Expo titulo="Plano de la Expo · CFP 401" descripcion="El plano de la Expo del CFP 401 del viernes 13/11, con los stands y los horarios de las muestras activas.">
    <main class="hoja">
        <header>
            <p class="etiqueta">Expo CFP 401 · Viernes 13 de noviembre · {ABRE.slice(0, 2)} a {CIERRA.slice(0, 2)} h</p>
            <h1>Plano y muestras activas</h1>
        </header>

        <section class="ahora" aria-live="polite">
            <div><span>Ahora</span><strong data-ahora>—</strong></div>
            <div><span>Después</span><strong data-despues>—</strong></div>
        </section>

        <p class="deslizar">Deslizá el plano de costado para verlo entero → · Tocá un stand para ver su muestra</p>
        <div class="mapa">
            <svg viewBox={`${VISTA.x} ${VISTA.y} ${VISTA.ancho} ${VISTA.alto}`} role="img" aria-label="Plano de la Expo: tocá un stand para ver qué muestra y a qué hora">
                <!-- La vista satelital, desenfocada: los techos dan la forma del edificio -->
                <image class="satelite" href={fondo} x={VISTA.x} y={VISTA.y} width={VISTA.ancho} height={VISTA.alto} preserveAspectRatio="none" />
                <g class="entrada">
                    <path class="flecha" d={`M${flechaX - 17} ${ENTRADA.y - 4} v-60 h-18 l35 -50 l35 50 h-18 v60 z`} />
                    <rect x={ENTRADA.x} y={ENTRADA.y} width={ENTRADA.ancho} height={ENTRADA.alto} rx="6" />
                    <text x={ENTRADA.x + ENTRADA.ancho / 2} y={ENTRADA.y + 33}>Entrada</text>
                    <text x={ENTRADA.x + ENTRADA.ancho / 2} y={ENTRADA.y + 58} class="chico">calle H. Irigoyen</text>
                </g>
                {rotulos.map((s) => {
                    const cx = s.x + s.ancho / 2;
                    const cy = s.y + s.alto / 2;
                    const salto = s.tam * 1.2;
                    return (
                        <g
                            class:list={['stand', { servicio: s.servicio, nuestro: s.nuestro }]}
                            data-stand={s.id}
                            tabindex={s.servicio ? undefined : '0'}
                            role={s.servicio ? undefined : 'button'}
                            aria-label={s.servicio ? undefined : s.nombre}
                        >
                            {s.forma
                                ? <path class="caja" d={s.forma} style={`fill:${s.color}`} />
                                : <rect class="caja" x={s.x} y={s.y} width={s.ancho} height={s.alto} rx="6" style={`fill:${s.color}`} />}
                            <text
                                x={cx}
                                y={cy - ((s.renglones.length - 1) * salto) / 2}
                                font-size={s.tam}
                                transform={s.vertical ? `rotate(-90 ${cx} ${cy})` : undefined}
                            >
                                {s.renglones.map((r, i) => <tspan x={cx} dy={i === 0 ? 0 : salto}>{r}</tspan>)}
                            </text>
                        </g>
                    );
                })}
                <!-- En el celular el plano no entra: en el patio (que está vacío) avisa que hay más a la derecha -->
                <g class="pista-deslizar" aria-hidden="true" transform="translate(515 450)">
                    <rect x="-128" y="-86" width="256" height="226" rx="24" />
                    <text y="-50">Deslizá</text>
                    <text y="-14">para ver más</text>
                    <path class="pista-flecha" d="M-62 20 h96 v-13 l30 20 l-30 20 v-13 h-96 z" />
                    <!-- La mano arrastra hacia la izquierda: así se mueve el plano para ver lo de la derecha -->
                    <g class="pista-mano"><circle class="pista-toque" cx="-4" cy="72" r="16" /><text class="pista-dedo" y="104">👆</text></g>
                </g>
            </svg>
        </div>
        <p class="fuente">Vista satelital: Esri, Maxar, Earthstar Geographics</p>

        <section class="ficha" aria-live="polite">
            <p class="etiqueta">Stand</p>
            <h2 data-ficha-nombre>Tocá un stand en el plano</h2>
            <p data-ficha-detalle>Acá vas a ver qué curso es y si tiene una muestra activa.</p>
            <ul data-ficha-muestras hidden></ul>
            <a class="boton" data-ficha-catalogo hidden target="_blank" rel="noopener">🛍️ Ver qué hay en este stand</a>
        </section>

        <section class="cronograma">
            <h2>Muestras activas</h2>
            <p class="pista">👆 Tocá una muestra y te llevamos a su stand en el plano.</p>
            {hayEjemplos && <p class="aviso">⏳ Los horarios todavía no están confirmados: los de esta lista son <strong>de ejemplo</strong>.</p>}
            <ol>
                {conHora.map((m) => (
                    <li data-muestra={m.stand} data-hora={m.hora} class:list={{ general: !m.stand }}>
                        <time>{m.desde && <small>desde</small>}{m.hora}</time>
                        <div>
                            <strong>{m.titulo}</strong>
                            <span>{m.stand ? nombreDe[m.stand] : 'Toda la Expo'}{!m.desde && ` · ${m.minutos} min`}{m.ejemplo && <em> · horario de ejemplo</em>}</span>
                        </div>
                    </li>
                ))}
            </ol>
            {todaLaTarde.length > 0 && <h3>Durante toda la tarde</h3>}
            <ol>
                {todaLaTarde.map((m) => (
                    <li data-muestra={m.stand}>
                        <time class="siempre">🕓</time>
                        <div>
                            <strong>{m.titulo}</strong>
                            <span>{m.stand && nombreDe[m.stand]}</span>
                        </div>
                    </li>
                ))}
            </ol>
        </section>

    </main>
</Expo>

<script is:inline type="application/json" id="datos-plano" set:html={JSON.stringify(datos)}></script>

<script>
    interface Muestra { stand?: string; titulo: string; hora: string; minutos: number; detalle?: string; desde?: boolean; todaLaTarde?: boolean; ejemplo?: boolean }
    interface Stand { id: string; nombre: string; detalle: string; servicio?: boolean; nuestro?: boolean; catalogo?: string }
    const { stands, muestras, dia, abre, cierra } = JSON.parse(document.getElementById('datos-plano')!.textContent!) as { stands: Stand[]; muestras: Muestra[]; dia: string; abre: string; cierra: string };
    const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
    const aMinutos = (hora: string) => Number(hora.slice(0, 2)) * 60 + Number(hora.slice(3));
    const nombre = (id?: string) => stands.find((s) => s.id === id)?.nombre ?? '';
    // "Ahora" y "Después" miran solo las que tienen hora: las de toda la tarde estarían siempre "ahora"
    const conHora = muestras.filter((m) => !m.todaLaTarde);

    function elegir(id: string) {
        const s = stands.find((x) => x.id === id);
        if (!s || s.servicio) return;
        document.querySelectorAll('.stand').forEach((g) => g.classList.toggle('elegido', (g as HTMLElement).dataset.stand === id));
        $('[data-ficha-nombre]').textContent = s.nombre;
        $('[data-ficha-detalle]').textContent = s.detalle;
        // Con el QR pegado en el stand (?aca=ID): la ficha de ESE stand dice dónde estás
        const estaAca = id === new URLSearchParams(location.search).get('aca');
        $('.ficha .etiqueta').textContent = estaAca ? '📍 Estás acá' : 'Stand';
        if (estaAca && s.nuestro) $('[data-ficha-detalle]').textContent = '¡Gracias por visitar nuestro stand! ' + s.detalle;
        const catalogo = $('[data-ficha-catalogo]') as HTMLAnchorElement;
        catalogo.hidden = !s.catalogo;
        if (s.catalogo) catalogo.href = s.catalogo;
        const suyas = muestras.filter((m) => m.stand === id);
        $('[data-ficha-muestras]').hidden = false;
        $('[data-ficha-muestras]').replaceChildren(
            ...(suyas.length
                ? suyas.map((m) => {
                    const li = document.createElement('li');
                    const cuando = m.todaLaTarde ? 'Toda la tarde' : (m.desde ? 'Desde las ' : '') + m.hora;
                    li.append(Object.assign(document.createElement('strong'), { textContent: `${cuando} · ${m.titulo}${m.ejemplo ? ' (horario de ejemplo)' : ''}` }));
                    if (m.detalle) li.append(Object.assign(document.createElement('span'), { textContent: ' ' + m.detalle }));
                    return li;
                })
                : [Object.assign(document.createElement('li'), { textContent: 'Sin muestra activa anotada.', className: 'nada' })]),
        );
        document.querySelectorAll<HTMLElement>('[data-muestra]').forEach((li) => li.classList.toggle('marcada', li.dataset.muestra === id));
        centrar(`.stand[data-stand="${CSS.escape(id)}"] .caja`);
    }

    // En el celular el plano se desliza de costado: lo elegido (Soldadura está a la derecha de todo) se
    // trae al centro, para no tener que buscarlo
    const mapa = $('.mapa');
    function centrar(sel: string) {
        const el = document.querySelector(sel);
        if (!el || mapa.scrollWidth <= mapa.clientWidth) return;
        const r = el.getBoundingClientRect();
        const m = mapa.getBoundingClientRect();
        mapa.scrollTo({ left: mapa.scrollLeft + r.left + r.width / 2 - (m.left + m.width / 2), behavior: 'smooth' });
    }
    // La flecha del patio: solo si el plano no entra, y se va cuando ya se deslizó
    const pista = document.querySelector<SVGGElement>('.pista-deslizar')!;
    const verPista = () => pista.classList.toggle('oculta', mapa.scrollWidth <= mapa.clientWidth + 4 || mapa.scrollLeft > 40);
    mapa.addEventListener('scroll', verPista, { passive: true });
    addEventListener('resize', verPista);
    verPista();

    document.querySelectorAll<HTMLElement>('.stand:not(.servicio)').forEach((g) => {
        g.addEventListener('click', () => elegir(g.dataset.stand!));
        g.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                elegir(g.dataset.stand!);
            }
        });
    });
    document.querySelectorAll<HTMLElement>('[data-muestra]').forEach((li) => li.addEventListener('click', () => {
        if (!li.dataset.muestra) return; // la apertura no es de un stand
        elegir(li.dataset.muestra);
        document.querySelector('.mapa')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));

    // ---- "Estás acá": el QR pegado en cada stand abre el plano con ?aca=ID (o ?aca=entrada) ----
    const aca = new URLSearchParams(location.search).get('aca');
    // El pin se pone al costado del stand que tenga lugar: prueba derecha, izquierda, abajo y arriba, y se
    // queda con el primero cuyo cartel no tapa otro stand ni se sale del plano (si ninguno, el que menos tapa).
    type Caja = { x: number; y: number; w: number; h: number };
    const cajaDe = (r: SVGGraphicsElement): Caja => { const b = r.getBBox(); return { x: b.x, y: b.y, w: b.width, h: b.height }; };
    const PINES = {
        // punta: dónde toca el stand · caja: lo que ocupa el pin entero, medido desde la punta · dibujo
        derecha: { punta: (c: Caja) => [c.x + c.w, c.y + c.h / 2], caja: { x: 0, y: -22, w: 204, h: 44 },
            dibujo: '<path d="M0 0 l24 -14 a16 16 0 1 1 0 28 z"/><circle cx="34" r="6"/><rect x="54" y="-20" width="148" height="40" rx="20"/><text x="128" y="7">📍 Estás acá</text>' },
        izquierda: { punta: (c: Caja) => [c.x, c.y + c.h / 2], caja: { x: -204, y: -22, w: 204, h: 44 },
            dibujo: '<path d="M0 0 l-24 -14 a16 16 0 1 0 0 28 z"/><circle cx="-34" r="6"/><rect x="-202" y="-20" width="148" height="40" rx="20"/><text x="-128" y="7">📍 Estás acá</text>' },
        abajo: { punta: (c: Caja) => [c.x + c.w / 2, c.y + c.h], caja: { x: -76, y: 0, w: 152, h: 94 },
            dibujo: '<path d="M0 0 l-14 24 a16 16 0 1 0 28 0 z"/><circle cy="34" r="6"/><rect x="-74" y="52" width="148" height="40" rx="20"/><text y="79">📍 Estás acá</text>' },
        arriba: { punta: (c: Caja) => [c.x + c.w / 2, c.y], caja: { x: -76, y: -94, w: 152, h: 94 },
            dibujo: '<path d="M0 0 l-14 -24 a16 16 0 1 1 28 0 z"/><circle cy="-34" r="6"/><rect x="-74" y="-92" width="148" height="40" rx="20"/><text y="-65">📍 Estás acá</text>' },
    };
    const lugar = (() => {
        const sel = aca === 'entrada' ? '.entrada rect' : `.stand:not(.servicio)[data-stand="${CSS.escape(aca ?? '')}"] .caja`;
        const r = aca ? document.querySelector<SVGGraphicsElement>(sel) : null;
        if (!r) return null;
        const propia = cajaDe(r);
        const otras = [...document.querySelectorAll<SVGGraphicsElement>('.stand .caja, .entrada rect')].filter((x) => x !== r).map(cajaDe);
        const vista = (document.querySelector('.mapa svg') as SVGSVGElement).viewBox.baseVal;
        const pisa = (a: Caja, b: Caja) => Math.max(0, Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)) * Math.max(0, Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y));
        const opciones = Object.entries(PINES).map(([lado, p]) => {
            const [x, y] = p.punta(propia);
            const caja = { x: x + p.caja.x, y: y + p.caja.y, w: p.caja.w, h: p.caja.h };
            const afuera = caja.w * caja.h - pisa(caja, { x: vista.x, y: vista.y, w: vista.width, h: vista.height });
            return { x, y, dibujo: p.dibujo, tapa: otras.reduce((t, o) => t + pisa(caja, o), 0) + afuera * 2, lado };
        });
        return opciones.find((o) => o.tapa === 0) ?? opciones.sort((a, b) => a.tapa - b.tapa)[0];
    })();
    if (lugar) {
        // Se dibuja después del resto para quedar arriba
        const svg = document.querySelector('.mapa svg')!;
        const ns = 'http://www.w3.org/2000/svg';
        const pin = document.createElementNS(ns, 'g');
        pin.setAttribute('class', 'aca');
        pin.dataset.lado = lugar.lado;
        pin.setAttribute('transform', `translate(${lugar.x} ${lugar.y})`);
        pin.innerHTML = lugar.dibujo;
        svg.append(pin);
        // Se va solo a los 20 segundos: ya se ubicaron y no tapa el plano mientras lo recorren
        setTimeout(() => pin.classList.add('oculto'), 20_000);
        if (aca === 'entrada') {
            $('.ficha .etiqueta').textContent = '📍 Estás acá';
            $('[data-ficha-nombre]').textContent = 'Entrada de la Expo';
            $('[data-ficha-detalle]').textContent = 'Tocá un stand en el plano para ver qué curso es y si tiene una muestra activa.';
            centrar('.entrada rect');
        } else {
            elegir(aca!);
        }
    }

    // "Ahora" y "Después", con la hora de Argentina
    function reloj() {
        const partes = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Argentina/Buenos_Aires', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
        const p = Object.fromEntries(partes.map((x) => [x.type, x.value]));
        const hoy = `${p.year}-${p.month}-${p.day}`;
        const ahora = Number(p.hour) * 60 + Number(p.minute);
        const texto = (m: Muestra) => `${m.hora} · ${m.titulo}${m.stand ? ` (${nombre(m.stand)})` : ''}`;
        const muestras = conHora;
        let enCurso = '—';
        let proxima = '—';
        if (hoy < dia) {
            enCurso = `La Expo es el viernes 13/11, de ${abre.slice(0, 2)} a ${cierra.slice(0, 2)} h`;
            if (muestras[0]) proxima = texto(muestras[0]);
        } else if (hoy > dia || ahora >= aMinutos(cierra)) {
            enCurso = 'La Expo ya terminó. ¡Gracias por venir!';
        } else if (ahora < aMinutos(abre)) {
            enCurso = `Hoy abrimos a las ${abre}`;
            if (muestras[0]) proxima = texto(muestras[0]);
        } else {
            const actual = muestras.find((m) => ahora >= aMinutos(m.hora) && ahora < aMinutos(m.hora) + m.minutos);
            const siguiente = muestras.find((m) => aMinutos(m.hora) > ahora);
            enCurso = actual ? texto(actual) : 'Recorré los stands';
            proxima = siguiente ? texto(siguiente) : 'No hay más muestras hoy';
            document.querySelectorAll<HTMLElement>('[data-hora]').forEach((li) => {
                const m = aMinutos(li.dataset.hora!);
                li.classList.toggle('pasada', ahora >= m + 15);
            });
        }
        $('[data-ahora]').textContent = enCurso;
        $('[data-despues]').textContent = proxima;
    }
    reloj();
    setInterval(reloj, 30_000);
</script>

<style>
    .hoja {
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
        max-width: 980px;
        margin: 0 auto;
        padding: 20px max(16px, env(safe-area-inset-right, 0px)) 48px max(16px, env(safe-area-inset-left, 0px));
        display: grid;
        gap: 18px;
    }
    header {
        display: grid;
        gap: 4px;
    }
    .etiqueta {
        margin: 0;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--suave);
    }
    h1 {
        margin: 0;
        font-size: clamp(1.8rem, 5vw, 2.6rem);
        line-height: 1.1;
        color: var(--oro);
    }
    .ahora {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 10px;
    }
    .ahora div {
        display: grid;
        gap: 2px;
        padding: 12px 14px;
        border: 1px solid var(--borde);
        border-radius: 12px;
        background: var(--superficie);
    }
    .ahora span {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--menta);
    }
    .mapa {
        overflow-x: auto;
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        background: #12171f;
        padding: 6px;
    }
    .mapa svg {
        display: block;
        width: 100%;
        min-width: 720px; /* en el celular se desliza: si entra entero, los nombres no se leen */
        height: auto;
    }
    .deslizar {
        margin: 0 0 -10px;
        font-size: 0.85rem;
        color: var(--suave);
    }
    @media (min-width: 600px) {
        .deslizar {
            font-size: 0;
        }
        .deslizar::after {
            content: 'Tocá un stand para ver su muestra';
            font-size: 0.85rem;
        }
    }
    .flecha {
        fill: #cfd6e2;
    }
    .pista {
        margin: -4px 0 0;
        color: var(--menta);
        font-weight: 600;
    }
    .pista-deslizar {
        pointer-events: none;
        transition: opacity 0.4s;
    }
    .pista-deslizar.oculta {
        opacity: 0;
    }
    .pista-deslizar rect {
        fill: rgba(13, 16, 23, 0.82);
        stroke: #ffffff;
        stroke-width: 3;
    }
    .pista-deslizar text {
        fill: #ffffff;
        font: 800 30px system-ui, sans-serif;
        text-anchor: middle;
        dominant-baseline: middle;
    }
    .pista-flecha {
        fill: #f2c14e;
        animation: empujar 1.2s ease-in-out infinite;
    }
    @keyframes empujar {
        50% {
            transform: translateX(16px);
        }
    }
    .pista-deslizar .pista-dedo {
        font-size: 58px;
    }
    .pista-toque {
        fill: rgba(242, 193, 78, 0.55);
    }
    /* Apoya el dedo a la derecha, arrastra a la izquierda, lo levanta y vuelve */
    .pista-mano {
        animation: arrastrar 2.4s ease-in-out infinite;
    }
    @keyframes arrastrar {
        0% {
            transform: translateX(70px);
            opacity: 0;
        }
        15% {
            transform: translateX(70px);
            opacity: 1;
        }
        65% {
            transform: translateX(-70px);
            opacity: 1;
        }
        80%,
        100% {
            transform: translateX(-70px);
            opacity: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .pista-flecha,
        .pista-mano {
            animation: none;
        }
    }
    .fuente {
        margin: -14px 0 0;
        font-size: 0.7rem;
        color: var(--suave);
        text-align: right;
    }
    .entrada rect {
        fill: #bcd5ee;
    }
    .entrada text,
    .stand text {
        fill: #10131a;
        font-weight: 800;
        text-anchor: middle;
        dominant-baseline: middle;
        font-family: system-ui, sans-serif;
        pointer-events: none;
    }
    .entrada text {
        font-size: 22px;
