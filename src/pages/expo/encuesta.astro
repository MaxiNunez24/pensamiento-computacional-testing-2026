---
/**
 * La encuesta de los cursos 2027: /expo/encuesta/
 *
 * Para saber qué días y horarios le sirven a la gente interesada en los cursos del año que viene
 * (Usuaria/o de IA generativa y Programador/a Web). Es anónima: nombre y WhatsApp son opcionales y
 * solo se guardan si la persona marca que se los podemos guardar para avisarle de las inscripciones.
 * Las respuestas las guarda el Worker de los catálogos (POST /encuesta) y se cuentan en el panel.
 */
import Expo from '../../layouts/Expo.astro';
import { CURSOS, DIAS, HORARIO } from '../../data/expo/encuesta';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Expo titulo="Cursos 2027 · CFP 401" descripcion="¿Qué días y horarios te sirven para los cursos 2027 del CFP 401? Contestá en un minuto.">
  <main class="hoja">
    <header>
      <p class="etiqueta">CFP 401 · Ensenada · Cursos 2027</p>
      <h1>¿Cuándo podrías cursar?</h1>
      <p class="bajada">Estamos armando los horarios del año que viene. Contestá en un minuto: <strong>es anónima</strong>.</p>
    </header>

    <form class="formulario" data-form>
      <fieldset>
        <legend>¿Qué curso te interesa?</legend>
        {CURSOS.map((c) => (
          <label class="opcion">
            <input type="radio" name="curso" value={c.codigo} required />
            <span><strong>{c.texto}</strong>{c.detalle && <small>{c.detalle}</small>}</span>
          </label>
        ))}
      </fieldset>

      <fieldset>
        <legend>¿Qué días podrías? <small>marcá todos los que te sirvan</small></legend>
        <div class="fichas">
          {DIAS.map((d) => (
            <label class="ficha">
              <input type="checkbox" name="dias" value={d.codigo} />
              <span>{d.texto}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="horarios">
        <legend>¿En qué horario? <small>cada clase dura 3 h 20 min: corré el bloque y agregá todos los que te sirvan (hasta {HORARIO.maximo})</small></legend>
        <!-- El día de 8 a 22: los bloques agregados en dorado y el que se está eligiendo, con borde -->
        <div class="dia" data-dia aria-hidden="true">
          <div class="dia__pista" data-pista>
            <span class="bloque bloque--eligiendo" data-eligiendo></span>
          </div>
          <div class="dia__horas">
            {Array.from({ length: (HORARIO.hasta - HORARIO.desde) / 120 + 1 }, (_, i) => (
              <span style={`left: ${((i * 120) / (HORARIO.hasta - HORARIO.desde)) * 100}%`}>{HORARIO.desde / 60 + i * 2}</span>
            ))}
          </div>
        </div>
        <div class="eleccion">
          <button type="button" class="flechita" data-mover="-1" aria-label="10 minutos antes">◀</button>
          <output class="eleccion__franja" data-franja aria-live="polite"></output>
          <button type="button" class="flechita" data-mover="1" aria-label="10 minutos después">▶</button>
        </div>
        <input
          type="range"
          class="deslizador"
          data-inicio
          min={HORARIO.desde}
          max={HORARIO.hasta - HORARIO.duracion}
          step={HORARIO.paso}
          value="800"
          aria-label="Cuándo empieza la clase"
        />
        <button type="button" class="agregar" data-agregar>+ Agregar este horario</button>
        <ul class="elegidos" data-elegidos></ul>
      </fieldset>

      <fieldset>
        <legend>¿Algo más que quieras contarnos? <small>opcional</small></legend>
        <textarea name="comentario" rows="2" maxlength="300" placeholder="Ej. solo puedo después de las 18"></textarea>
      </fieldset>

      <fieldset class="avisar">
        <label class="opcion">
          <input type="checkbox" name="consentimiento" data-consentimiento />
          <span><strong>Quiero que me avisen cuando abran las inscripciones</strong><small>Tu nombre y WhatsApp se usan solo para eso: no se publican ni se comparten.</small></span>
        </label>
        <div class="contacto" data-contacto hidden>
          <label>Nombre <input name="nombre" maxlength="60" autocomplete="given-name" /></label>
          <label>WhatsApp <input name="whatsapp" inputmode="tel" maxlength="20" autocomplete="tel" placeholder="221 555 0000" /></label>
        </div>
      </fieldset>

      <p class="error" data-error role="alert"></p>
      <button type="submit" class="boton" data-enviar>Enviar</button>
    </form>

    <section class="gracias" data-gracias hidden>
      <p class="grande">¡Gracias! 💚</p>
      <p>Con lo que contesten armamos los horarios de 2027.</p>
      <p><a href={`${base}/expo/`}>Mirá lo que hicimos este año</a></p>
    </section>
  </main>
</Expo>

<script>
  import { WORKER } from '../../scripts/bingo-expo';
  import { HORARIO, franja } from '../../data/expo/encuesta';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');

  // ---------- Los horarios: un bloque de 3 h 20 que se corre por el día ----------
  const largo = HORARIO.hasta - HORARIO.desde;
  const ultimo = HORARIO.hasta - HORARIO.duracion;
  const deslizador = $<HTMLInputElement>('[data-inicio]');
  const elegidos: number[] = [];
  const ajustar = (m: number) => Math.max(HORARIO.desde, Math.min(ultimo, HORARIO.desde + Math.round((m - HORARIO.desde) / HORARIO.paso) * HORARIO.paso));
  const ubicar = (bloque: HTMLElement, inicio: number) => {
    bloque.style.left = `${((inicio - HORARIO.desde) / largo) * 100}%`;
    bloque.style.width = `${(HORARIO.duracion / largo) * 100}%`;
  };

  function dibujarHorarios() {
    const inicio = Number(deslizador.value);
    ubicar($('[data-eligiendo]'), inicio);
    $('[data-franja]').textContent = franja(inicio);
    // los agregados, en la pista y en la lista
    const pista = $('[data-pista]');
    pista.querySelectorAll('.bloque--elegido').forEach((b) => b.remove());
    for (const m of elegidos) {
      const b = document.createElement('span');
      b.className = 'bloque bloque--elegido';
      ubicar(b, m);
      pista.prepend(b);
    }
    const lista = $('[data-elegidos]');
    lista.replaceChildren(
      ...elegidos.map((m) => {
        const li = document.createElement('li');
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.textContent = '✕';
        quitar.setAttribute('aria-label', `Quitar ${franja(m)}`);
        quitar.addEventListener('click', () => {
          elegidos.splice(elegidos.indexOf(m), 1);
          dibujarHorarios();
        });
        li.append(franja(m), quitar);
        return li;
      }),
    );
    const agregar = $<HTMLButtonElement>('[data-agregar]');
    const repetido = elegidos.includes(inicio);
    const lleno = elegidos.length >= HORARIO.maximo;
    agregar.disabled = repetido || lleno;
    agregar.textContent = lleno ? `Ya elegiste ${HORARIO.maximo}: quitá uno para cambiarlo` : repetido ? 'Ese ya está agregado' : '+ Agregar este horario';
  }
  deslizador.addEventListener('input', dibujarHorarios);
  for (const flecha of document.querySelectorAll<HTMLButtonElement>('[data-mover]')) {
    flecha.addEventListener('click', () => {
      deslizador.value = String(ajustar(Number(deslizador.value) + Number(flecha.dataset.mover) * HORARIO.paso));
      dibujarHorarios();
    });
  }
  // Tocar el día pone el bloque centrado ahí
  $('[data-dia]').addEventListener('click', (e) => {
    const caja = $('[data-pista]').getBoundingClientRect();
    const minuto = HORARIO.desde + ((e.clientX - caja.left) / caja.width) * largo;
    deslizador.value = String(ajustar(minuto - HORARIO.duracion / 2));
    dibujarHorarios();
  });
  $('[data-agregar]').addEventListener('click', () => {
    const inicio = Number(deslizador.value);
    if (elegidos.includes(inicio) || elegidos.length >= HORARIO.maximo) return;
    elegidos.push(inicio);
    elegidos.sort((a, b) => a - b);
    $('[data-error]').textContent = '';
    dibujarHorarios();
  });
  dibujarHorarios();
  const consentimiento = $<HTMLInputElement>('[data-consentimiento]');
  consentimiento.addEventListener('change', () => ($('[data-contacto]').hidden = !consentimiento.checked));

  // Que quien la contestó desde este celular no la mande dos veces sin querer
  try {
    if (localStorage.getItem('encuesta2027:enviada')) {
      $('[data-gracias]').hidden = false;
      form.hidden = true;
    }
  } catch {
    /* sin recordar */
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const datos = new FormData(form);
    const cuerpo = {
      curso: datos.get('curso'),
      dias: datos.getAll('dias'),
      horarios: elegidos,
      comentario: datos.get('comentario'),
      consentimiento: consentimiento.checked,
      nombre: consentimiento.checked ? datos.get('nombre') : '',
      whatsapp: consentimiento.checked ? datos.get('whatsapp') : '',
    };
    const error = $('[data-error]');
    if (!cuerpo.dias.length) return void (error.textContent = 'Marcá al menos un día.');
    if (!cuerpo.horarios.length) return void (error.textContent = 'Agregá al menos un horario (el botón «+ Agregar este horario»).');
    error.textContent = '';
    const boton = $<HTMLButtonElement>('[data-enviar]');
    boton.disabled = true;
    boton.textContent = 'Enviando…';
    try {
      const r = await fetch(`${WORKER}/encuesta`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) });
      const respuesta = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(respuesta.error || 'No se pudo enviar.');
      try {
        localStorage.setItem('encuesta2027:enviada', '1');
      } catch {
        /* nada */
      }
      form.hidden = true;
      $('[data-gracias]').hidden = false;
      scrollTo({ top: 0 });
    } catch (err) {
      error.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'No se pudo enviar. ¿Tenés internet?';
      boton.disabled = false;
      boton.textContent = 'Enviar';
    }
  });
</script>

<style>
  .hoja {
    max-width: 560px;
    margin: 0 auto;
    padding: 24px 16px 48px;
    display: grid;
    gap: 20px;
  }
  [hidden] {
    display: none !important;
  }
  header {
    text-align: center;
  }
  .etiqueta {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--suave);
  }
  h1 {
    margin: 6px 0;
    font-size: 2.1rem;
    line-height: 1.15;
    color: var(--oro);
  }
  .bajada {
    margin: 0;
    color: var(--suave);
  }
  .formulario {
    display: grid;
    gap: 16px;
  }
  fieldset {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--superficie);
    display: grid;
    gap: 10px;
  }
  /* float saca al legend del borde (si no, el navegador lo dibuja cortando la línea de arriba)
     y, dentro de la grilla, queda como la primera fila: el título adentro del recuadro */
  legend {
    float: left;
    width: 100%;
    padding: 0;
    font-weight: 700;
    font-size: 1.1rem;
  }
  legend small,
  .opcion small,
  .ficha small {
    color: var(--suave);
    font-weight: 400;
    font-size: 0.85rem;
  }
  .opcion {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    cursor: pointer;
  }
  .opcion span {
    display: grid;
  }
  .opcion input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--oro);
  }
  .fichas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ficha input {
    position: absolute;
    opacity: 0;
  }
  .ficha span {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 999px;
    border: 2px solid var(--borde);
    cursor: pointer;
    font-weight: 600;
  }
  .ficha input:checked + span {
    background: var(--oro);
    border-color: var(--oro);
    color: #10131a;
  }
  .ficha input:checked + span small {
    color: #10131a;
  }
  .ficha input:focus-visible + span {
    outline: 3px solid var(--menta);
    outline-offset: 2px;
  }
  /* ---------- horarios ---------- */
  .dia {
    cursor: pointer;
    padding-top: 4px;
  }
  .dia__pista {
    position: relative;
    height: 44px;
    border-radius: 10px;
    background: repeating-linear-gradient(90deg, var(--fondo) 0 calc(100% / 7 - 1px), var(--borde) calc(100% / 7 - 1px) calc(100% / 7));
    border: 1px solid var(--borde);
    overflow: hidden;
  }
  .dia__pista :global(.bloque) {
    position: absolute;
    top: 4px;
    bottom: 4px;
    border-radius: 7px;
    transition: left 0.15s ease;
  }
  .dia__pista :global(.bloque--elegido) {
    background: var(--oro);
    opacity: 0.85;
  }
  .bloque--eligiendo {
    border: 3px solid var(--menta);
    background: color-mix(in srgb, var(--menta) 18%, transparent);
    z-index: 1;
  }
  .dia__horas {
    position: relative;
    height: 1.3em;
    font-size: 0.8rem;
    color: var(--suave);
  }
  .dia__horas span {
    position: absolute;
    transform: translateX(-50%);
  }
  .dia__horas span:first-child {
    transform: none;
  }
  .dia__horas span:last-child {
    transform: translateX(-100%);
  }
  .eleccion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .eleccion__franja {
    font-size: 1.5rem;
    font-weight: 800;
    min-width: 8.5em;
    text-align: center;
  }
  .flechita {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--borde);
    background: none;
    color: var(--texto);
    font-size: 1rem;
    cursor: pointer;
  }
  .deslizador {
    width: 100%;
    accent-color: var(--menta);
  }
  .agregar {
    padding: 12px 16px;
    border-radius: 999px;
    border: 2px solid var(--menta);
    background: none;
    color: var(--menta);
    font: 700 1rem system-ui, sans-serif;
    cursor: pointer;
  }
  .agregar:disabled {
    border-color: var(--borde);
    color: var(--suave);
    cursor: default;
  }
  .elegidos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .elegidos:empty {
    display: none;
  }
  .elegidos :global(li) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    background: var(--oro);
    color: #10131a;
    font-weight: 700;
  }
  .elegidos :global(button) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgb(0 0 0 / 0.15);
    color: #10131a;
    cursor: pointer;
  }

  textarea,
  .contacto input {
    font: inherit;
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--borde);
    background: var(--fondo);
    color: var(--texto);
  }
  .contacto {
    display: grid;
    gap: 10px;
  }
  .contacto label {
    display: grid;
    gap: 4px;
    font-weight: 600;
  }
  .error {
    margin: 0;
    min-height: 1.4em;
    color: var(--coral);
    text-align: center;
  }
  .boton {
    padding: 16px 20px;
    border-radius: 999px;
    border: 2px solid var(--oro);
    background: var(--oro);
    color: #10131a;
    font: 800 1.2rem system-ui, sans-serif;
    cursor: pointer;
  }
  .boton:disabled {
    opacity: 0.6;
  }
  .gracias {
    text-align: center;
    padding: 28px 16px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--superficie);
  }
  .gracias .grande {
    font-size: 2rem;
    font-weight: 800;
    color: var(--oro);
    margin-top: 0;
  }
  .gracias a {
    color: var(--oro);
  }
</style>
