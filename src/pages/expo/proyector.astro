---
/**
 * La pantalla del proyector en la Expo: /expo/proyector/
 *
 * Va en la segunda salida de la notebook (pantalla extendida): de ahí, por su único HDMI (el cable de
 * 5 m), al proyector y a la lona. No hay monitor aparte para las bolillas: se descartó el 6/11, sin
 * divisor HDMI. La maneja la página del operador (/expo/bingo/operador/), que
 * queda en la pantalla de la notebook: nadie tiene que apuntarle con el mouse a esta.
 *
 * El diseño elegido (boceto 2 + la idea del 5): una pantalla grande a la izquierda y un carrusel a la
 * derecha (Bingo, Catálogos, Stand 3D), con la barra del proyector y los sponsors abajo. Entre rondas,
 * lo grande es la animación del sistema; con una ronda abierta o en juego, el Bingo pasa solo a la
 * pantalla grande y el sistema entra al carrusel. A mano, con Ctrl + flechas (acá o desde el operador):
 *
 *   ←/→  pasa el carrusel
 *   ↑    lo que muestra el carrusel pasa a la pantalla grande; otra vez, a toda la lona
 *   ↓    un paso atrás: deja la lona entera, y después vuelve a lo automático
 *
 * Los sponsors: cuando pasan 10 minutos sin ronda del Bingo y sin que nadie toque el operador, ocupan
 * toda la lona unos 35 segundos (una pantalla por cada principal y una con los demás). Cualquier tecla
 * del operador los saltea, y si se abre una ronda se van solos. Para verlos ya: ?sponsors en la dirección.
 */
import Expo from '../../layouts/Expo.astro';
import { qr, direccion, vidriera, vidrieraDeEjemplo } from '../../data/expo/expo';

const catalogos = await Promise.all(vidriera.map(async (e) => ({ ...e, qr: await qr(e.link) })));
const qrExpo = await qr(direccion(Astro.site, 'expo/'));
const qrEncuesta = await qr(direccion(Astro.site, 'expo/encuesta/'));

// Los que apoyan el stand. Los principales aportaron más: tienen su propia pantalla, más grande
const instagram = (usuario: string) => `https://www.instagram.com/${usuario}/`;
const logos = import.meta.env.BASE_URL.replace(/\/$/, '') + '/expo/sponsors/';
const principales = await Promise.all(
  [
    { nombre: 'Puerto Informático', logo: 'puerto-informatico.png', usuario: 'puertoinformatico', texto: 'Sponsor principal del stand: ¡gracias por apoyar al curso!' },
    { nombre: 'La Gráfica', logo: 'la-grafica.png', usuario: 'lagrafica.ensenada', texto: 'Nos donó el papel térmico: cada foto y cada cartón que te llevás impreso sale gracias a La Gráfica.' },
  ].map(async (x) => ({ ...x, qr: await qr(instagram(x.usuario)) })),
);
const otros = await Promise.all(
  [
    { nombre: 'Dylcell', logo: 'dylcell.png', usuario: 'dylcell' },
    { nombre: 'CLC Accesorios', logo: 'clc.png', usuario: 'clc_accesorios_' },
    { nombre: 'Tecno Cell', logo: 'tecnocell.png', usuario: 'telefoniaexpress_' },
  ].map(async (x) => ({ ...x, qr: await qr(instagram(x.usuario)) })),
);
// En el pie se turnan los nombres cada 8 segundos
const sponsors = [...principales, ...otros].map((x) => x.nombre);
---

<Expo titulo="Proyector · Expo CFP 401" descripcion="La pantalla del proyector del stand de Pensamiento Computacional.">
  <div class="lona" data-lona>
    <header class="cabeza">
      <h1>Pensamiento Computacional y Testing de Aplicaciones 2026</h1>
    </header>

    <!-- Lo que se ve en el carrusel y cuánto falta para que cambie (antes eran todos los nombres en pastillas) -->
    <div class="carrusel__nombres" aria-hidden="true">
      <span data-nombre-actual></span>
      <i class="carrusel__tiempo"><b data-tiempo></b></i>
    </div>

    <!-- ============ El Bingo ============ -->
    <section class="panel bingo" data-tarjeta="bingo" data-nombre="Bingo" data-fase="espera" aria-label="Bingo">
      <h2 class="panel__titulo">Bingo</h2>

      <div class="bingo__espera">
        <p class="bingo__grande">Ya empieza<br />una ronda</p>
        <p class="bingo__chico">Rondas gratis con el celular y rondas con premio, con cartón de la caja</p>
      </div>

      <div class="bingo__abierta">
        <span class="bingo__qr" data-qr></span>
        <span class="bingo__caja" aria-hidden="true">🎟️</span>
        <div class="bingo__textos">
          <p class="bingo__grande bingo__llamado" data-llamado>¡Sumate!</p>
          <p class="bingo__premio" data-premio></p>
          <p class="bingo__chico"><strong data-como>Escaneá y jugá gratis</strong><br /><span data-tamano></span></p>
          <p class="bingo__nota" data-impreso></p>
        </div>
      </div>

      <div class="bingo__jugando">
        <div class="bingo__arriba">
          <span class="bolilla" data-ultima></span>
          <div>
            <p class="bingo__cuenta" data-cuenta></p>
            <p class="bingo__nota" data-premio-jugando></p>
          </div>
        </div>
        <ol class="tablero" data-tablero></ol>
      </div>

      <div class="bingo__aviso" data-aviso hidden>
        <p class="bingo__grande" data-aviso-titulo></p>
        <p class="bingo__chico" data-aviso-texto></p>
        <div class="bingo__numeros" data-aviso-numeros></div>
      </div>

      <div class="bingo__moneda" data-moneda hidden>
        <div class="escena-moneda">
          <div class="moneda" data-moneda-cuerpo>
            <div class="lado cara">CARA</div>
            <div class="lado cruz">CRUZ</div>
          </div>
        </div>
        <p class="bingo__chico" data-moneda-lados></p>
        <p class="bingo__grande bingo__resultado" data-moneda-resultado></p>
      </div>
    </section>

    <!-- ============ ¿Qué construimos? El sistema ============ -->
    <section class="panel" data-tarjeta="sistema" data-nombre="El sistema" aria-label="El Sistema de Gestión de Alumnos">
      <h2 class="panel__titulo">¿Qué construimos?</h2>
      <p class="panel__bajada">Animaciones de catálogo y sistema de gestión</p>
      <div class="panel__escena">
        <motor-escena escena="expo-siges" loop autoplay sin-controles sin-lupa sin-sonido movimiento="completo"></motor-escena>
      </div>
      <p class="panel__esquina"><span class="qr-chico" set:html={qrExpo} aria-hidden="true" /> Todo en tu celular</p>
    </section>

    <!-- ============ Las fotos con IA: el ruido que se vuelve tu cara ============ -->
    <section class="panel" data-tarjeta="fotos" data-nombre="Fotos con IA" aria-label="Las fotos con IA">
      <h2 class="panel__titulo">Tu foto con IA</h2>
      <p class="panel__bajada">Sacate una foto y llevátela impresa</p>
      <div class="panel__escena">
        <motor-escena escena="expo-fotos-ia" loop autoplay sin-controles sin-lupa sin-sonido movimiento="completo"></motor-escena>
        <!-- Las fotos de quienes aceptaron salir en el stand: las trae el estudio (por Tailscale), nunca internet -->
        <div class="vitrina-lona" data-vitrina hidden>
          <img alt="" data-vitrina-foto />
          <p>📺 Ya se sacaron la suya</p>
        </div>
      </div>
      <p class="panel__esquina"><span class="qr-chico" set:html={qrEncuesta} aria-hidden="true" /> Cursos 2027: ¿qué días podés?</p>
    </section>

    <!-- ============ Los catálogos ============ -->
    <section class="panel" data-tarjeta="catalogos" data-nombre="Catálogos" aria-label="Los catálogos">
      <h2 class="panel__titulo">Catálogos</h2>
      <p class="panel__bajada">Para emprendedores del CFP{vidrieraDeEjemplo && ' (de ejemplo)'}</p>
      <div class="vidriera" data-vidriera>
        {catalogos.map((c, i) => (
          <article class="vidriera__item" hidden={i > 0}>
            <span class="vidriera__emoji" aria-hidden="true">{c.emoji}</span>
            <p class="vidriera__nombre">{c.emprendimiento}</p>
            <p class="vidriera__rubro">{c.rubro}</p>
            <span class="vidriera__qr" set:html={c.qr} role="img" aria-label={`QR del catálogo de ${c.emprendimiento}`} />
          </article>
        ))}
      </div>
      <p class="vidriera__todos"><span class="qr-chico" set:html={qrExpo} aria-hidden="true" /> Todos en tu celular</p>
    </section>

    <!-- ============ El stand en 3D ============ -->
    <section class="panel" data-tarjeta="stand" data-nombre="Stand 3D" aria-label="El stand en 3D">
      <h2 class="panel__titulo">El stand</h2>
      <p class="panel__bajada">Qué vas a encontrar acá</p>
      <svg class="stand" viewBox="0 0 400 260" aria-hidden="true">
        <g stroke="#a3adbd" stroke-width="2" fill="none" stroke-linejoin="round">
          <path d="M60 170L200 230L340 170L200 110Z" fill="#1d2433" />
          <path d="M60 170V80L200 20V110" fill="#141a26" />
          <path d="M200 20L340 80V170" fill="#10151f" />
          <path d="M95 112l60-26v34l-60 26z" fill="#f2c14e33" stroke="#f2c14e" />
          <path d="M150 175l40 17l40-17l-40-17z" fill="#4fd1b544" stroke="#4fd1b5" />
          <path d="M235 158l30 13l30-13l-30-13z" fill="#7aa7ff44" stroke="#7aa7ff" />
        </g>
      </svg>
      <ul class="stand__lista">
        <li><span>🎱</span> Bingo con premios</li>
        <li><span>🛍️</span> Catálogos de emprendedores</li>
        <li><span>🖨️</span> Tu foto impresa</li>
        <li><span>🧩</span> El sistema del CFP</li>
      </ul>
    </section>

    <!-- ============ Abajo: lo recaudado para la cooperadora y los que apoyan ============ -->
    <footer class="pie">
      <div class="barra">
        <p class="barra__que">💚 Todo lo recaudado va a la cooperadora del CFP<small>cada catálogo, impresión y cartón suma</small></p>
        <p class="barra__listado" data-listado hidden></p>
        <p class="barra__cuanto" data-barra-cuanto hidden></p>
      </div>
      <div class="apoyo">
        <span>Con el apoyo de</span>
        <span class="apoyo__nombres">
          {sponsors.map((s, i) => <strong class="apoyo__nombre" hidden={i > 0}>{s}</strong>)}
        </span>
      </div>
    </footer>
  </div>

  <!-- ============ Los sponsors, a pantalla completa cuando la lona está quieta ============ -->
  <div class="sponsors" data-sponsors hidden>
    {principales.map((x) => (
      <section class="sponsors__pantalla" data-pantalla hidden>
        <p class="sponsors__etiqueta">Sponsor principal</p>
        <div class="sponsors__principal">
          <img class="sponsors__logo" src={logos + x.logo} alt={x.nombre} />
          <span class="sponsors__qr" set:html={x.qr} role="img" aria-label={`QR del Instagram de ${x.nombre}`} />
        </div>
        <p class="sponsors__texto">{x.texto}</p>
        <p class="sponsors__ig">Seguilos en Instagram: <strong>@{x.usuario}</strong></p>
      </section>
    ))}
    <section class="sponsors__pantalla" data-pantalla hidden>
      <p class="sponsors__etiqueta">También nos apoyan</p>
      <div class="sponsors__otros">
        {otros.map((x) => (
          <figure>
            <img src={logos + x.logo} alt={x.nombre} />
            <span class="sponsors__qr" set:html={x.qr} role="img" aria-label={`QR del Instagram de ${x.nombre}`} />
            <figcaption>@{x.usuario}</figcaption>
          </figure>
        ))}
      </div>
    </section>
    <p class="sponsors__pie">Si vas a sus locales o les escribís, contales que venís de parte del CFP 401 💚</p>
  </div>

  <p class="ayuda" data-ayuda>Pasá esta ventana a la pantalla del proyector y apretá <kbd>F11</kbd></p>
</Expo>

<script>
  import 'motor-animaciones';
  import '../../animaciones/expo-siges.js';
  import '../../animaciones/expo-fotos-ia.js';
  import QRCode from 'qrcode';
  import { canal, accionDeVista, describirTamano, linkDeRonda, WORKER, type Estado, type Mensaje } from '../../scripts/bingo-expo';

  const $ = <T extends Element = HTMLElement>(sel: string, raiz: ParentNode = document) => raiz.querySelector<T>(sel)!;
  const turnar = (elementos: HTMLElement[], cada: number) => {
    let i = 0;
    if (elementos.length > 1) {
      setInterval(() => {
        elementos[i].hidden = true;
        i = (i + 1) % elementos.length;
        elementos[i].hidden = false;
      }, cada);
    }
  };

  // ---------- La vitrina del estudio: las fotos que la gente aceptó mostrar ----------
  // El estudio corre en la PC del stand y la lona en la notebook: las fotos viajan por Tailscale (como el
  // operador desde la notebook) y nunca pasan por internet. La dirección se pasa UNA vez con
  // ?estudio=https://<la PC>.<tu red>.ts.net y queda guardada en este navegador.
  const ESTUDIO = (() => {
    const pedida = new URLSearchParams(location.search).get('estudio');
    try {
      if (pedida) localStorage.setItem('proyector:estudio', pedida);
      return (pedida ?? localStorage.getItem('proyector:estudio') ?? '').replace(/\/$/, '');
    } catch {
      return (pedida ?? '').replace(/\/$/, '');
    }
  })();
  if (ESTUDIO) {
    const caja = $('[data-vitrina]');
    const animacion = $('[data-tarjeta="fotos"] motor-escena');
    const foto = $<HTMLImageElement>('[data-vitrina-foto]');
    let fotos: string[] = [];
    let cual = 0;
    const mostrarFoto = () => {
      const hay = fotos.length > 0;
      caja.hidden = !hay;
      animacion.hidden = hay; // sin fotos todavía, la animación de siempre
      if (!hay) return;
      cual %= fotos.length;
      foto.src = `${ESTUDIO}/vitrina/${encodeURIComponent(fotos[cual])}`;
      foto.style.animation = 'none';
      void foto.offsetWidth;
      foto.style.animation = '';
    };
    const leerFotos = async () => {
      try {
        const r = await fetch(`${ESTUDIO}/api/vitrina`, { cache: 'no-store' });
        if (r.ok) {
          const lista: string[] = await r.json();
          if (lista.join() !== fotos.join()) {
            fotos = lista;
            cual = 0; // la más nueva primero
            mostrarFoto();
          }
        }
      } catch {
        /* el estudio cerrado o sin Tailscale: queda lo último que se vio */
      }
    };
    leerFotos();
    setInterval(leerFotos, 15000);
    setInterval(() => {
      if (fotos.length > 1) {
        cual += 1;
        mostrarFoto();
      }
    }, 4000);
  }

  // ---------- Dónde va cada tarjeta: la pantalla grande o el carrusel ----------
  const lona = $('[data-lona]');
  const tarjetas = new Map([...document.querySelectorAll<HTMLElement>('[data-tarjeta]')].map((t) => [t.dataset.tarjeta!, t]));
  const ORDEN = ['bingo', 'catalogos', 'fotos', 'stand', 'sistema'];
  const CADA = 12000; // cuánto queda cada tarjeta en el carrusel
  // Entre rondas, en la pantalla grande se turnan el sistema y las fotos con IA (cada una dura ~1 minuto)
  const TURNO_GRANDE = 110000;

  let forzada: string | null = null; // la que se pasó a mano a la pantalla grande
  let completa = false; // la pantalla grande ocupa toda la lona
  let enCarrusel = 'catalogos';
  let bingoActivo = false;
  let reloj: ReturnType<typeof setInterval> | null = null;
  let grandeEntreRondas: 'sistema' | 'fotos' = 'sistema';

  // ---------- Los sponsors a pantalla completa, cuando la lona está quieta ----------
  const SPONSORS_CADA = 10 * 60 * 1000; // 10 minutos sin ronda y sin tocar el operador
  const DURACION = [12000, 12000, 11000]; // cada pantalla: los dos principales y los demás
  const sponsorsCaja = $('[data-sponsors]');
  const pantallas = [...sponsorsCaja.querySelectorAll<HTMLElement>('[data-pantalla]')];
  let quietoDesde = Date.now();
  let mostrando: ReturnType<typeof setTimeout> | null = null;

  function ocultarSponsors() {
    if (mostrando) clearTimeout(mostrando);
    mostrando = null;
    sponsorsCaja.hidden = true;
    quietoDesde = Date.now(); // la próxima vez, en otros 10 minutos
  }
  function mostrarSponsors(i = 0) {
    if (i >= pantallas.length) return ocultarSponsors();
    sponsorsCaja.hidden = false;
    pantallas.forEach((pantalla, k) => (pantalla.hidden = k !== i));
    mostrando = setTimeout(() => mostrarSponsors(i + 1), DURACION[i] ?? 11000);
  }
  setInterval(() => {
    if (bingoActivo) {
      if (mostrando) ocultarSponsors();
      quietoDesde = Date.now();
    } else if (!mostrando && Date.now() - quietoDesde >= SPONSORS_CADA) {
      mostrarSponsors();
    }
  }, 5000);
  if (new URLSearchParams(location.search).has('sponsors')) mostrarSponsors();

  const principal = () => forzada ?? (bingoActivo ? 'bingo' : grandeEntreRondas);
  const delCarrusel = () => ORDEN.filter((n) => n !== principal());

  function ubicar() {
    const grande = principal();
    const opciones = delCarrusel();
    if (!opciones.includes(enCarrusel)) enCarrusel = opciones[0];
    for (const [nombre, tarjeta] of tarjetas) {
      tarjeta.dataset.lugar = nombre === grande ? 'escenario' : nombre === enCarrusel && !completa ? 'carrusel' : 'oculta';
    }
    lona.classList.toggle('completa', completa);
    $('[data-nombre-actual]').textContent = tarjetas.get(enCarrusel)!.dataset.nombre!;
    try {
      localStorage.setItem('proyector:vista', JSON.stringify({ forzada, completa }));
    } catch {
      /* nada */
    }
  }

  // La barra se llena en CADA milisegundos: se reinicia cada vez que el carrusel arranca a contar de nuevo
  function reiniciarBarra() {
    const barra = $('[data-tiempo]');
    barra.style.animation = 'none';
    void barra.offsetWidth; // para que la animación vuelva a arrancar
    barra.style.animation = `llenar ${CADA}ms linear`;
  }
  function pasar(paso: number) {
    const opciones = delCarrusel();
    enCarrusel = opciones[(opciones.indexOf(enCarrusel) + paso + opciones.length) % opciones.length];
    ubicar();
    reiniciarBarra();
  }
  function arrancarCarrusel() {
    if (reloj) clearInterval(reloj);
    reloj = setInterval(() => pasar(1), CADA);
    reiniciarBarra();
  }

  function mover(accion: string) {
    // Con los sponsors en pantalla, cualquier tecla del operador solo los saltea
    if (mostrando) return ocultarSponsors();
    quietoDesde = Date.now();
    if (accion === 'anterior' || accion === 'siguiente') {
      pasar(accion === 'anterior' ? -1 : 1);
      arrancarCarrusel(); // a mano: el próximo cambio solo, recién en 12 segundos
      return;
    }
    if (accion === 'agrandar') {
      if (forzada === null) {
        const antes = principal();
        forzada = enCarrusel;
        enCarrusel = antes; // la que estaba en grande queda a la vista en el carrusel
      } else {
        completa = true;
      }
    }
    if (accion === 'achicar') {
      if (completa) completa = false;
      else forzada = null;
    }
    ubicar();
  }

  try {
    const guardada = JSON.parse(localStorage.getItem('proyector:vista') || 'null');
    if (guardada && (guardada.forzada === null || ORDEN.includes(guardada.forzada))) ({ forzada, completa } = guardada);
  } catch {
    /* nada */
  }
  ubicar();
  arrancarCarrusel();
  setInterval(() => {
    grandeEntreRondas = grandeEntreRondas === 'sistema' ? 'fotos' : 'sistema';
    if (forzada === null && !bingoActivo) {
      // La que entra a lo grande arranca desde el principio, no por la mitad
      tarjetas.get(grandeEntreRondas)!.querySelector<HTMLElement & { irA?: (t: number) => void }>('motor-escena')?.irA?.(0);
      ubicar();
    }
  }, TURNO_GRANDE);

  document.addEventListener('keydown', (evento) => {
    const mensaje = accionDeVista(evento);
    if (mensaje?.tipo === 'vista') {
      evento.preventDefault();
      mover(mensaje.accion);
    }
  });

  // El cartelito de ayuda se va solo, o al pasar a pantalla completa
  const ayuda = $('[data-ayuda]');
  setTimeout(() => ayuda.remove(), 12000);
  window.addEventListener('resize', () => {
    if (innerHeight === screen.height) ayuda.remove();
  });

  // ---------- Lo que se turna: catálogos y sponsors ----------
  turnar([...document.querySelectorAll<HTMLElement>('.vidriera__item')], 8000);
  turnar([...document.querySelectorAll<HTMLElement>('.apoyo__nombre')], 8000);

  // ---------- La barra de la cooperadora ----------
  // Lo carga Maxi desde el panel (/expo/panel/, pestaña Cooperadora): cuánto se recaudó (sin meta ni
  // total, lo pidieron los directivos) y un listado SOLO informativo de lo que necesita cada curso,
  // que se va turnando.
  let listado: { texto: string; curso: string }[] = [];
  let enListado = 0;
  async function actualizarBarra() {
    try {
      const datos = await (await fetch(`${WORKER}/cooperadora`)).json();
      const cuanto = $('[data-barra-cuanto]');
      cuanto.hidden = !(datos.recaudado > 0);
      cuanto.innerHTML = `$${Number(datos.recaudado).toLocaleString('es-AR')} <small>recaudados</small>`;
      listado = Array.isArray(datos.listado) ? datos.listado : [];
      if (enListado >= listado.length) enListado = 0;
      mostrarListado();
    } catch {
      /* sin internet: queda como estaba */
    }
  }
  function mostrarListado() {
    const caja = $('[data-listado]');
    caja.hidden = listado.length === 0;
    if (!listado.length) return;
    const item = listado[enListado];
    caja.innerHTML = '';
    const chico = document.createElement('small');
    chico.textContent = 'Lo que se necesita';
    const texto = document.createElement('span');
    texto.textContent = item.curso ? `${item.texto} · ${item.curso}` : item.texto;
    caja.append(chico, texto);
    caja.classList.remove('cambia');
    void caja.offsetWidth;
    caja.classList.add('cambia');
  }
  actualizarBarra();
  setInterval(actualizarBarra, 20000);
  setInterval(() => {
    if (listado.length < 2) return;
    enListado = (enListado + 1) % listado.length;
    mostrarListado();
  }, 6000);

  // ---------- El Bingo: dibuja lo que manda el operador ----------
  const bingo = $('.bingo');
  const tablero = $('[data-tablero]');
  const aviso = $('[data-aviso]');
  const monedaCaja = $('[data-moneda]');
  const moneda = $('[data-moneda-cuerpo]');
  let qrDe = '';
  let ultimaMoneda = 0;
  let estado: Estado | null = null;
  let ultimoCambio = Date.now();
  let volver: ReturnType<typeof setTimeout> | null = null;

  // Con un ganador ya anunciado, el Bingo se queda en grande un rato y vuelve al carrusel solo
  const DESPUES_DEL_BINGO = 90000;
  function revisarActivo() {
    const e = estado;
    const terminada = !!e && e.ganadores.some((g) => !g.fuera) && !e.moneda && Date.now() - ultimoCambio > DESPUES_DEL_BINGO;
    const activo = !!e?.ronda && !terminada;
    if (volver) clearTimeout(volver);
    if (activo && e!.ganadores.length) volver = setTimeout(revisarActivo, DESPUES_DEL_BINGO + 500);
    if (activo !== bingoActivo) {
      bingoActivo = activo;
      ubicar();
    }
  }

  async function dibujar(nuevo: Estado) {
    const antes = estado;
    estado = nuevo;
    ultimoCambio = Date.now();
    const { ronda, tamano, sorteadas } = nuevo;
    bingo.dataset.fase = !ronda ? 'espera' : sorteadas.length === 0 ? 'abierta' : 'jugando';
    revisarActivo();

    if (ronda && qrDe !== ronda + tamano) {
      qrDe = ronda + tamano;
      $('[data-qr]').innerHTML = await QRCode.toString(linkDeRonda(ronda, tamano), {
        type: 'svg',
        margin: 1,
        errorCorrectionLevel: 'M',
        color: { dark: '#10131a', light: '#ffffff' },
      });
    }
    $('[data-tamano]').textContent = describirTamano(tamano);
    // Ronda con premio: sin QR (los cartones salen de la caja) y el premio en grande
    const caja = !!nuevo.soloCaja;
    bingo.classList.toggle('bingo--caja', caja);
    $('[data-llamado]').textContent = caja ? '¡Ronda con premio!' : '¡Sumate!';
    // "Teclado (1 de 2)" es para la lista del operador; el público lee "Teclado"
    const premioLona = (nuevo.premio || '').replace(/\s*\(\d+ de \d+\)\s*$/, '');
    $('[data-premio]').textContent = premioLona ? 'Se juega por ' + premioLona : '';
    $('[data-como]').textContent = caja ? 'Pedí tu cartón en la caja' : 'Escaneá y jugá gratis';
    $('[data-impreso]').textContent = caja ? nuevo.precio ?? '' : nuevo.impreso;
    $('[data-premio-jugando]').textContent = premioLona ? 'Se juega por ' + premioLona : '';

    // El tablero: todos los números de la ronda, con los que salieron pintados
    const maximo = Number(tamano.split('-')[1]);
    if (tablero.children.length !== maximo) {
      tablero.style.setProperty('--columnas', String(maximo / 5));
      tablero.replaceChildren(
        ...Array.from({ length: maximo }, (_, i) => {
          const li = document.createElement('li');
          li.textContent = String(i + 1);
          return li;
        }),
      );
    }
    [...tablero.children].forEach((li, i) => {
      li.classList.toggle('salio', sorteadas.includes(i + 1));
      li.classList.toggle('ultima', sorteadas.at(-1) === i + 1);
    });
    const ultima = $('[data-ultima]');
    const nuevaBolilla = sorteadas.at(-1);
    if (ultima.textContent !== String(nuevaBolilla ?? '')) {
      ultima.textContent = String(nuevaBolilla ?? '');
      ultima.classList.remove('cae');
      void ultima.offsetWidth; // para que la animación vuelva a arrancar
      ultima.classList.add('cae');
    }
    $('[data-cuenta]').textContent = sorteadas.length ? `Bolilla ${sorteadas.length} de ${maximo}` : '';

    dibujarAviso(nuevo);

    // La moneda: se anima una vez por tirada
    if (nuevo.moneda && nuevo.moneda.id !== ultimaMoneda) {
      ultimaMoneda = nuevo.moneda.id;
      if (antes) tirarMoneda(nuevo);
      else mostrarMoneda(nuevo); // recién abierta la ventana: sin animación
    }
    if (!nuevo.moneda) monedaCaja.hidden = true;
  }

  function dibujarAviso({ ganadores }: Estado) {
    const quedan = ganadores.filter((g) => !g.fuera);
    if (quedan.length === 0) {
      aviso.hidden = true;
      return;
    }
    const primera = Math.min(...quedan.map((g) => g.bolilla));
    const empatados = quedan.filter((g) => g.bolilla === primera);
    aviso.hidden = false;
    const numeros = $('[data-aviso-numeros]');
    if (empatados.length === 1) {
      $('[data-aviso-titulo]').textContent = '¡BINGO!';
      $('[data-aviso-texto]').textContent = `Ganó el cartón ${empatados[0].codigo}`;
      numeros.replaceChildren(
        ...empatados[0].numeros.map((n) => {
          const s = document.createElement('span');
          s.className = 'bolilla bolilla--chica';
          s.textContent = String(n);
          return s;
        }),
      );
    } else {
      $('[data-aviso-titulo]').textContent = '¡Empate!';
      $('[data-aviso-texto]').textContent = `${empatados.map((g) => g.codigo).join(' · ')}: lo decide la moneda`;
      numeros.replaceChildren();
    }
  }

  function textosMoneda(e: Estado) {
    const m = e.moneda!;
    $('[data-moneda-lados]').textContent = m.modo === 'desempate' ? `Cara: ${m.cara} · Cruz: ${m.cruz}` : 'Cara o cruz';
    return m.modo === 'desempate' ? `Ganó ${m.salio === 'cara' ? m.cara : m.cruz}` : `¡Salió ${m.salio}!`;
  }

  function mostrarMoneda(e: Estado) {
    monedaCaja.hidden = false;
    aviso.hidden = true;
    moneda.classList.toggle('muestra-cruz', e.moneda!.salio === 'cruz');
    $('[data-moneda-resultado]').textContent = textosMoneda(e);
  }

  function tirarMoneda(e: Estado) {
    monedaCaja.hidden = false;
    aviso.hidden = true;
    textosMoneda(e);
    $('[data-moneda-resultado]').textContent = '';
    moneda.classList.remove('muestra-cruz', 'gira-cara', 'gira-cruz');
    void moneda.offsetWidth;
    moneda.classList.add('gira-' + e.moneda!.salio);
  }

  moneda.addEventListener('animationend', () => {
    if (!estado?.moneda) return;
    moneda.classList.remove('gira-cara', 'gira-cruz');
    moneda.classList.toggle('muestra-cruz', estado.moneda.salio === 'cruz');
    $('[data-moneda-resultado]').textContent = textosMoneda(estado);
  });

  canal.addEventListener('message', ({ data }: MessageEvent<Mensaje>) => {
    if (data.tipo === 'estado') dibujar(data.estado);
    if (data.tipo === 'vista') mover(data.accion);
  });
  // Recién abierta: le pide al operador cómo va la ronda
  canal.postMessage({ tipo: 'hola' } satisfies Mensaje);
</script>

