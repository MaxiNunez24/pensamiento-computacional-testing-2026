---
/**
 * /expo/panel/: el panel privado del stand, con la clave de administración de los catálogos.
 *
 * Página aparte, sin el menú del curso (como /expo/stand/). Junta lo que el profe necesita a mano en
 * clase y en la Expo: las páginas del stand y sus atajos, los links para compartir, el paso a paso de
 * los catálogos y las consultas para los directivos y los sponsors.
 *
 * Este archivo está en el repo público: acá va solo lo que no es secreto. El checklist de consultas y
 * las imágenes (bocetos, opciones para los sponsors) los guarda el Worker de los catálogos y los
 * entrega con la clave (GET /admin/panel). Se cargan con scripts/subir-panel.py desde
 * contenido-privado/expo/, que no se sube.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Los links para compartir son siempre los publicados, aunque la página corra en desarrollo
const sitio = new URL(base + '/', Astro.site).href;
const catalogos = 'https://cfp401-ensenada.github.io/catalogos/';

const paginas = [
    { titulo: 'Operador del Bingo', detalle: 'La pantalla de la notebook, la que no se proyecta', href: `${base}/expo/bingo/operador/`, icono: '🎱' },
    { titulo: 'Pantalla del proyector', detalle: 'Se abre desde el operador; pasarla a la lona y F11', href: `${base}/expo/proyector/`, icono: '📽️' },
    { titulo: 'Estudio de fotos con IA', detalle: 'En la PC de la IA: abrir-estudio.bat. Desde la notebook o el celu (con Tailscale): la dirección https://maxi-pc… que muestra su ventana', href: 'http://127.0.0.1:8791/', icono: '📸' },
    { titulo: 'Stand en 3D', detalle: 'El modelo a escala, con la planta y lo que hay que conseguir', href: `${base}/expo/stand/`, icono: '🧊' },
    { titulo: 'Vista pública de la Expo', detalle: 'Lo que ve cualquiera que entra al link', href: `${base}/expo/`, icono: '🌐' },
    { titulo: 'QR "Estás acá" del plano', detalle: 'La lista de stands con su código y un QR por stand para imprimir y pegar', href: `${base}/expo/plano/qrs/`, icono: '📍' },
    { titulo: 'Animación sin internet', detalle: 'La escena del sistema a pantalla completa, para un monitor', href: `${base}/expo/pantalla/`, icono: '🎬' },
];

const links = [
    { titulo: 'La Expo', para: 'Público · directivos', url: `${sitio}expo/`, nota: 'Vidriera de catálogos y juegos' },
    { titulo: 'El recorrido del stand', para: 'Alumnos · directivos', url: `${sitio}expo/recorrido/`, nota: 'Cómo se armó todo, con las pruebas' },
    { titulo: 'Encuesta cursos 2027', para: 'Público · interesados', url: `${sitio}expo/encuesta/`, nota: 'Qué días y horarios prefieren' },
    { titulo: 'El curso', para: 'Alumnos', url: sitio, nota: 'Los ejercicios y el camino' },
    { titulo: 'Preparando la Expo', para: 'Alumnos', url: `${sitio}preparando-expo/`, nota: 'Las clases de la Expo' },
    { titulo: 'Armá tu catálogo', para: 'Emprendedores', url: `${sitio}armar-tu-catalogo/`, nota: 'El primer paso para tener catálogo' },
    { titulo: 'Editor de catálogos', para: 'Emprendedores', url: `${catalogos}editar/`, nota: 'Productos, precios y fotos, con su código' },
    { titulo: 'La teoría', para: 'Alumnos', url: 'https://maxinunez24.github.io/pensamiento-computacional-testing-2026/', nota: 'El sitio de las clases' },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>Panel del stand · Expo CFP 401</title>
        <meta name="robots" content="noindex, nofollow" />
        <link rel="icon" href={base + '/favicon.ico'} />
        <script is:inline>
            // El tema elegido se aplica antes de pintar, para que no parpadee
            try {
                const tema = localStorage.getItem('panel:tema');
                if (tema) document.documentElement.dataset.tema = tema;
            } catch (e) {}
        </script>
    </head>
    <body>
        <header class="barra">
            <span class="marca">Panel del stand <small>Expo CFP 401</small></span>
            <nav class="pestanas" id="pestanas" hidden>
                <a href="#expo">Expo</a>
                <a href="#cooperadora">Cooperadora</a>
                <a href="#vales">Vales</a>
                <a href="#encuesta">Encuesta</a>
                <a href="#links">Links</a>
                <a href="#catalogos">Catálogos</a>
                <a href="#consultas">Consultas</a>
            </nav>
            <button type="button" class="redondo" id="tema" aria-label="Cambiar entre modo claro y oscuro">🌙</button>
            <button type="button" class="redondo" id="salir" aria-label="Salir" title="Salir" hidden>⏏</button>
        </header>

        <!-- ===== La puerta ===== -->
        <main class="puerta" id="puerta">
            <form class="tarjeta" id="form-clave">
                <h1>Panel del stand</h1>
                <p>Con la clave de administración de los catálogos.</p>
                <input id="clave" type="password" autocomplete="current-password" aria-label="Clave" required />
                <button type="submit" class="principal">Entrar</button>
                <p class="error" id="error-clave" role="alert"></p>
            </form>
        </main>

        <main class="hoja" id="hoja" data-sitio={sitio} hidden>
            <!-- ===== Expo ===== -->
            <section id="expo" class="seccion">
                <h2>Para la Expo</h2>
                <div class="grilla">
                    {paginas.map((p) => (
                        <a class="tarjeta pagina" href={p.href} target="_blank" rel="noopener">
                            <span class="icono">{p.icono}</span>
                            <strong>{p.titulo}</strong>
                            <span>{p.detalle}</span>
                        </a>
                    ))}
                </div>

                <details class="tarjeta" open>
                    <summary><h3>Atajos del operador</h3> <small>F9 los prende y los apaga</small></summary>
                    <table class="atajos">
                        <tbody>
                            <tr><td><kbd>Espacio</kbd></td><td>Sacar una bolilla</td></tr>
                            <tr><td><kbd>A</kbd></td><td>Automático: saca sola cada tantos segundos (se frena al validar un Bingo)</td></tr>
                            <tr><td><kbd>N</kbd></td><td>Ronda nueva (dos veces si hay una en juego). Si hay una reservada, arranca esa</td></tr>
                            <tr><td><kbd>P</kbd></td><td>Reservar la próxima: la caja imprime sus cartones mientras se juega la actual</td></tr>
                            <tr><td><kbd>V</kbd> · <kbd>Enter</kbd> · <kbd>Esc</kbd></td><td>Ir al casillero del código · validarlo · salir del casillero</td></tr>
                            <tr><td><kbd>M</kbd></td><td>Moneda de desempate (siempre 50 %)</td></tr>
                            <tr><td><kbd>C</kbd> / <kbd>X</kbd></td><td>Moneda libre: la persona eligió cara / cruz</td></tr>
                            <tr><td><kbd>0</kbd>–<kbd>9</kbd></td><td>Probabilidad de la moneda libre (0 = 100 %). No se ve en la lona</td></tr>
                            <tr><td><kbd>Esc</kbd></td><td>Sacar la moneda de la pantalla</td></tr>
                            <tr><td><kbd>Ctrl</kbd> + <kbd>←</kbd> <kbd>→</kbd></td><td>Pasar el carrusel de la lona</td></tr>
                            <tr><td><kbd>Ctrl</kbd> + <kbd>↑</kbd></td><td>Lo que muestra el carrusel pasa a la pantalla grande; otra vez, a toda la lona</td></tr>
                            <tr><td><kbd>Ctrl</kbd> + <kbd>↓</kbd></td><td>Un paso atrás: deja la lona entera, y después vuelve a lo automático</td></tr>
                        </tbody>
                    </table>
                </details>

                <details class="tarjeta">
                    <summary><h3>Atajos del estudio de fotos</h3></summary>
                    <table class="atajos">
                        <tbody>
                            <tr><td><kbd>Espacio</kbd></td><td>Sacar la foto (cuenta 3, 2, 1)</td></tr>
                            <tr><td><kbd>←</kbd> <kbd>↑</kbd> <kbd>↓</kbd> <kbd>→</kbd></td><td>Elegir el estilo (como en la grilla)</td></tr>
                            <tr><td><kbd>M</kbd></td><td>Persona o mascota/objeto (con <kbd>Esc</kbd> se sale del casillero de "qué es")</td></tr>
                            <tr><td><kbd>Enter</kbd></td><td>Generar (unos 9 segundos)</td></tr>
                            <tr><td><kbd>R</kbd></td><td>Otra versión del mismo estilo</td></tr>
                            <tr><td><kbd>A</kbd></td><td>Aprobar e imprimir: el QR para el celular de Fun Print sale chico, abajo de la foto, por 15 segundos (la foto se borra a las 3 horas)</td></tr>
                            <tr><td><kbd>I</kbd></td><td>Volver a mostrar el QR de la impresora</td></tr>
                            <tr><td><kbd>Q</kbd></td><td>QR para llevársela, grande y solo (se borra el 16/11, o antes si la persona la borra)</td></tr>
                            <tr><td><kbd>Esc</kbd></td><td>Sacar los QR de la pantalla</td></tr>
                        </tbody>
                    </table>
                    <p class="nota">Mascotas y objetos: elegir "Mascota u objeto" y escribir qué es y cómo es ("un perro marrón y blanco"). Al cerrar el stand: "Borrar todas las fotos de esta PC".</p>
                </details>

                <details class="tarjeta">
                    <summary><h3>Reglas que conviene saber</h3></summary>
                    <ul class="reglas">
                        <li>Un cartón pedido <strong>después de la primera bolilla no vale</strong>: lo rechaza el operador solo, y desde la primera bolilla el QR deja de dar cartones de esa ronda.</li>
                        <li>Cada persona puede <strong>cambiar su cartón 2 veces</strong> por ronda, mientras no marque ningún número.</li>
                        <li>El tamaño del cartón se elige según la gente: hasta 5 personas, 5 números del 1 al 25; hasta 20, 6 del 1 al 30; más, 7 del 1 al 35.</li>
                        <li>Validar funciona <strong>sin internet</strong>; pedir cartones, no.</li>
                        <li>Con una ronda en juego, la lona pone el Bingo grande sola. Ctrl + flechas manda igual.</li>
                        <li>El celular de la impresora guarda los cartones que imprimió, por si hay que reimprimir uno.</li>
                    </ul>
                </details>
            </section>

            <!-- ===== Cooperadora ===== -->
            <section id="cooperadora" class="seccion">
                <h2>Cooperadora <small class="guardado" id="guardado-coop"></small></h2>
                <p class="nota">Lo que se ve en la barra de abajo del proyector: cuánto se recaudó (sin meta ni total) y, de a uno, lo que necesita cada curso. Se actualiza solo en unos 20 segundos.</p>
                <div class="tarjeta recaudado">
                    <label for="recaudado"><strong>Recaudado</strong> <small>en pesos, sin puntos. En 0 no se muestra</small></label>
                    <div class="fila">
                        <span class="peso">$</span>
                        <input id="recaudado" type="number" inputmode="numeric" min="0" step="1" />
                    </div>
                    <div class="cobros">
                        <strong>Cobros rápidos</strong>
                        <small>cada toque suma ese monto</small>
                        <button type="button" class="editar-cobros" id="editar-cobros" aria-pressed="false">✏️ Editar</button>
                    </div>
                    <div class="fila" id="botones-cobro"></div>
                    <form class="agregar" id="form-cobro" hidden>
                        <input id="cobro-nombre" placeholder="Para qué (ej. Impresión, Cartón)" aria-label="Para qué es el cobro" maxlength="30" />
                        <input id="cobro-monto" type="number" inputmode="numeric" min="1" step="1" placeholder="Monto" aria-label="Monto en pesos" required />
                        <button type="submit" class="principal">Agregar botón</button>
                    </form>
                </div>
                <div class="tarjeta">
                    <h3>Lo que necesita cada curso <small id="cuenta-listado"></small></h3>
                    <p class="nota">Solo informativo: no lleva precios ni se tilda.</p>
                    <ul class="checklist" id="listado"></ul>
                    <form class="agregar" id="form-listado">
                        <input id="item-texto" placeholder="Qué necesitan (ej. tinturas, hilo, tornillos)" aria-label="Qué necesitan" required maxlength="80" />
                        <input id="item-curso" list="cursos-cfp" placeholder="Curso" aria-label="Curso" maxlength="50" />
                        <button type="submit" class="principal">Agregar</button>
                    </form>
                </div>
            </section>

            <!-- ===== Vales ===== -->
            <section id="vales" class="seccion">
                <h2>Vales de donación</h2>
                <p class="nota">Para quien dona algo para la Expo. Creás el vale, le mandás el link y lo puede guardar o imprimir.</p>
                <form class="tarjeta formulario" id="form-vale">
                    <input type="hidden" id="vale-id" />
                    <label>Quién dona <input id="vale-quien" required maxlength="80" placeholder="Ej. Instructora de Peluquería" /></label>
                    <label>Curso <input id="vale-curso" list="cursos-cfp" maxlength="60" placeholder="Ej. Peluquería" /></label>
                    <label>Qué dona <input id="vale-que" required maxlength="120" placeholder="Ej. llaveros impresos" /></label>
                    <label>Cuántos <input id="vale-cantidad" maxlength="30" placeholder="Ej. 20" /></label>
                    <label class="ancho">Mensaje <textarea id="vale-mensaje" maxlength="400" rows="3"></textarea></label>
                    <div class="botones ancho">
                        <button type="submit" class="principal" id="vale-guardar">Crear vale</button>
                        <button type="button" id="vale-cancelar" hidden>Cancelar</button>
                        <span class="nota" id="vale-estado" role="status"></span>
                    </div>
                </form>
                <div class="grilla" id="lista-vales"></div>
                <p class="nota" id="sin-vales">Todavía no hay vales.</p>
            </section>

            <!-- ===== Encuesta 2027 ===== -->
            <section id="encuesta" class="seccion">
                <h2>Encuesta 2027 <small class="guardado" id="encuesta-total"></small></h2>
                <p class="nota">Qué días y horarios prefieren los interesados en los cursos del año que viene. El QR está en el proyector (tarjeta de las fotos con IA) y en la página pública de la Expo.</p>
                <div class="botones">
                    <a href={`${base}/expo/encuesta/`} target="_blank" rel="noopener">Abrir la encuesta</a>
                    <button type="button" data-qr-de={`${sitio}expo/encuesta/`} data-titulo="Cursos 2027: ¿qué días podés?">QR</button>
                    <button type="button" id="encuesta-actualizar">Actualizar</button>
                    <button type="button" id="encuesta-csv">Descargar CSV</button>
                </div>
                <div class="grilla" id="encuesta-conteos"></div>
                <div class="tarjeta" id="encuesta-cruce-caja">
                    <h3>Día × hora <small>cuántas personas pueden ese día a esa hora (13 = de 13 a 14)</small></h3>
                    <div class="tabla-ancha"><table class="cruce" id="encuesta-cruce"></table></div>
                </div>
                <div class="tarjeta">
                    <h3>Para avisarles <small id="encuesta-cuantos-contacto"></small></h3>
                    <p class="nota">Solo quienes marcaron que se los podía guardar. Es para avisarles de las inscripciones: no se publica ni se comparte.</p>
                    <ul class="contactos" id="encuesta-contactos"></ul>
                </div>
            </section>
            <datalist id="cursos-cfp"></datalist>

            <!-- ===== Links ===== -->
            <section id="links" class="seccion">
                <h2>Links para compartir</h2>
                <p class="nota">Copiar, mandar por WhatsApp o mostrar el QR en grande para que lo escaneen.</p>
                <div class="grilla">
                    {links.map((l) => (
                        <article class="tarjeta enlace" data-url={l.url} data-titulo={l.titulo}>
                            <span class="para">{l.para}</span>
                            <strong>{l.titulo}</strong>
                            <span>{l.nota}</span>
                            <code>{l.url.replace('https://', '')}</code>
                            <div class="botones">
                                <button type="button" data-accion="copiar">Copiar</button>
                                <button type="button" data-accion="compartir">Compartir</button>
                                <button type="button" data-accion="qr">QR</button>
                            </div>
                        </article>
                    ))}
                </div>
            </section>

            <!-- ===== Catálogos ===== -->
            <section id="catalogos" class="seccion">
                <h2>Cómo se arma un catálogo</h2>
                <p class="nota">De punta a punta, para un emprendimiento del CFP.</p>
                <ol class="pasos">
                    <li class="tarjeta">
                        <strong>El emprendedor elige cómo se ve</strong>
                        <span>Nombre, WhatsApp, colores y foto de fondo. Lo descarga y te manda el archivo.</span>
                        <div class="botones"><a href={`${sitio}armar-tu-catalogo/`} target="_blank" rel="noopener">Armá tu catálogo</a><button type="button" data-qr-de={`${sitio}armar-tu-catalogo/`} data-titulo="Armá tu catálogo">QR</button></div>
                    </li>
                    <li class="tarjeta">
                        <strong>Vos lo publicás</strong>
                        <span>La carpeta va al repo de la organización, con la dirección corta (ej. <code>dulces-de-la-isla</code>).</span>
                        <div class="botones"><a href="https://github.com/cfp401-ensenada/catalogos" target="_blank" rel="noopener">Repo de catálogos</a></div>
                    </li>
                    <li class="tarjeta">
                        <strong>Lo das de alta y sale el código</strong>
                        <span>En la administración de catálogos, con esta misma clave. El código es lo único que necesita para editar.</span>
                        <div class="botones"><a href={`${catalogos}admin/`} target="_blank" rel="noopener">Administración</a></div>
                    </li>
                    <li class="tarjeta">
                        <strong>Le pasás el link y el código</strong>
                        <span>Su catálogo queda en <code>cfp401-ensenada.github.io/catalogos/&lt;dirección&gt;/</code>. Los productos los carga desde el celular.</span>
                        <div class="botones"><a href={`${catalogos}editar/`} target="_blank" rel="noopener">Editor</a><button type="button" data-qr-de={`${catalogos}editar/`} data-titulo="Editor de catálogos">QR</button></div>
                    </li>
                    <li class="tarjeta">
                        <strong>Si pierde el código o se da de baja</strong>
                        <span>En la administración: "nuevo código" invalida el viejo; la baja borra datos, código y fotos (la carpeta del repo, aparte).</span>
                    </li>
                </ol>
                <p class="nota">La clase completa: <a href={`${base}/preparando-expo/catalogos-cfp/`} target="_blank" rel="noopener">Catálogos para todo el CFP</a>.</p>
            </section>

            <!-- ===== Consultas ===== -->
            <section id="consultas" class="seccion">
                <h2>Consultas <small class="guardado" id="guardado"></small></h2>
                <div id="checklist"></div>
                <form class="tarjeta agregar" id="form-agregar">
                    <input id="nueva" placeholder="Algo más para preguntar…" aria-label="Consulta nueva" required />
                    <input id="nueva-grupo" list="grupos" placeholder="Grupo" aria-label="Grupo" />
                    <datalist id="grupos"></datalist>
                    <button type="submit" class="principal">Agregar</button>
                </form>

                <h3>Para mostrar</h3>
                <div id="galeria"></div>
                <p class="nota" id="sin-imagenes" hidden>Todavía no hay imágenes cargadas (scripts/subir-panel.py).</p>
            </section>
        </main>

        <!-- QR en grande / imagen en grande -->
        <dialog class="grande" id="grande">
            <button type="button" class="redondo cerrar" id="cerrar" aria-label="Cerrar">✕</button>
            <button type="button" class="redondo flecha" id="anterior" aria-label="Anterior">‹</button>
            <figure id="grande-contenido"></figure>
            <button type="button" class="redondo flecha" id="siguiente" aria-label="Siguiente">›</button>
        </dialog>

        <script>
            import QRCode from 'qrcode';
            import { WORKER } from '../../scripts/bingo-expo';
            import { CURSOS, DIAS, HORARIO, franja, type Respuesta } from '../../data/expo/encuesta';

            const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

            // ---------- Tema ----------
            const raiz = document.documentElement;
            const oscuro = () => (raiz.dataset.tema ? raiz.dataset.tema === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches);
            const pintarTema = () => ($('#tema').textContent = oscuro() ? '☀️' : '🌙');
            $('#tema').addEventListener('click', () => {
                raiz.dataset.tema = oscuro() ? 'claro' : 'oscuro';
                try {
                    localStorage.setItem('panel:tema', raiz.dataset.tema);
                } catch {
                    /* sin recordar */
                }
                pintarTema();
            });
            pintarTema();
            // El mismo atajo que en todas las pantallas del stand
            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'o') {
                    e.preventDefault();
                    $('#tema').click();
                }
            });

            // ---------- La clave ----------
            interface Consulta {
                texto: string;
                grupo: string;
                hecho: boolean;
            }
            interface Imagen {
                id: string;
                titulo?: string;
                grupo?: string;
                tipo?: string;
                datos: string;
            }

            let clave = '';
            let consultas: Consulta[] = [];

            async function pedir(ruta: string, metodo = 'GET', cuerpo?: unknown) {
                let r: Response;
                try {
                    r = await fetch(WORKER + ruta, {
                        method: metodo,
                        headers: { 'X-Admin': clave, 'Content-Type': 'application/json' },
                        body: cuerpo ? JSON.stringify(cuerpo) : undefined,
                    });
                } catch {
                    throw new Error('No hay conexión con el servidor');
                }
                const datos = await r.json().catch(() => ({}));
                if (r.status === 401) throw new Error('Esa no es la clave.');
                if (!r.ok) throw new Error(datos.error || 'No se pudo');
                return datos;
            }

            async function entrar(valor: string) {
                clave = valor;
                $('#error-clave').textContent = '';
                try {
                    const datos = await pedir('/admin/panel');
                    try {
                        sessionStorage.setItem('stand:admin', clave);
                    } catch {
                        /* habrá que ponerla de nuevo */
                    }
                    // Si vino de una página privada (el stand), vuelve ahí
                    const volver = new URLSearchParams(location.search).get('volver');
                    if (volver && volver.startsWith('/') && !volver.startsWith('//')) {
                        location.replace(volver);
                        return;
                    }
                    $('#puerta').hidden = true;
                    $('#hoja').hidden = false;
                    $('#pestanas').hidden = false;
                    $('#salir').hidden = false;
                    consultas = datos.consultas;
                    dibujarConsultas();
                    dibujarGaleria(datos.imagenes);
                    cooperadora = { recaudado: 0, listado: [], ...datos.cooperadora };
                    dibujarCooperadora();
                    vales = datos.vales || [];
                    dibujarVales();
                    respuestas = normalizar(datos.encuesta || []);
                    dibujarEncuesta();
                    if (location.hash) document.querySelector(location.hash)?.scrollIntoView({ behavior: 'instant' });
                } catch (error) {
                    try {
                        sessionStorage.removeItem('stand:admin');
                    } catch {
                        /* nada */
                    }
                    $('#error-clave').textContent = error instanceof Error ? error.message : 'No se pudo';
                }
            }

            $('#form-clave').addEventListener('submit', (e) => {
                e.preventDefault();
                entrar($<HTMLInputElement>('#clave').value);
            });
            $('#salir').addEventListener('click', () => {
                try {
                    sessionStorage.removeItem('stand:admin');
                } catch {
                    /* nada */
                }
                location.reload();
            });

            // ---------- Consultas ----------
            // Se guardan solas unos segundos después del último cambio: la administración tiene un
            // límite de 10 pedidos por minuto, y tildar cinco cosas seguidas es un solo guardado.
            let espera = 0;
            function guardarLuego() {
                $('#guardado').textContent = 'sin guardar…';
                clearTimeout(espera);
                espera = window.setTimeout(async () => {
                    try {
                        await pedir('/admin/panel/consultas', 'PUT', { consultas });
                        $('#guardado').textContent = 'guardado ✓';
                    } catch (error) {
                        $('#guardado').textContent = 'no se guardó: ' + (error instanceof Error ? error.message : '');
                        guardarLuego();
                    }
                }, 5000);
            }
            addEventListener('beforeunload', (e) => {
                if ($('#guardado').textContent === 'sin guardar…') e.preventDefault();
            });

            function dibujarConsultas() {
                const grupos = [...new Set(consultas.map((c) => c.grupo))];
                $('#grupos').replaceChildren(...grupos.map((g) => Object.assign(document.createElement('option'), { value: g })));
                $('#checklist').replaceChildren(
                    ...grupos.map((grupo) => {
                        const caja = document.createElement('div');
                        caja.className = 'tarjeta grupo';
                        const items = consultas.filter((c) => c.grupo === grupo);
                        const titulo = document.createElement('h3');
                        titulo.textContent = `${grupo} `;
                        const cuenta = document.createElement('small');
                        cuenta.textContent = `${items.filter((c) => c.hecho).length} de ${items.length}`;
                        titulo.append(cuenta);
                        const lista = document.createElement('ul');
                        lista.className = 'checklist';
                        for (const c of items) {
                            const li = document.createElement('li');
                            const etiqueta = document.createElement('label');
                            const tilde = Object.assign(document.createElement('input'), { type: 'checkbox', checked: c.hecho });
                            tilde.addEventListener('change', () => {
                                c.hecho = tilde.checked;
                                dibujarConsultas();
                                guardarLuego();
                            });
                            const texto = document.createElement('span');
                            texto.textContent = c.texto;
                            etiqueta.append(tilde, texto);
                            const borrar = Object.assign(document.createElement('button'), { type: 'button', textContent: '✕', title: 'Borrar' });
                            borrar.className = 'borrar';
                            borrar.addEventListener('click', () => {
                                if (!confirm(`¿Borrar "${c.texto}"?`)) return;
                                consultas = consultas.filter((x) => x !== c);
                                dibujarConsultas();
                                guardarLuego();
                            });
                            li.append(etiqueta, borrar);
                            lista.append(li);
                        }
                        caja.append(titulo, lista);
                        return caja;
                    }),
                );
            }

            $('#form-agregar').addEventListener('submit', (e) => {
                e.preventDefault();
                const texto = $<HTMLInputElement>('#nueva').value.trim();
                const grupo = $<HTMLInputElement>('#nueva-grupo').value.trim() || 'Otros';
                if (!texto) return;
                consultas.push({ texto, grupo, hecho: false });
                $<HTMLInputElement>('#nueva').value = '';
                dibujarConsultas();
                guardarLuego();
            });

            // ---------- En grande: QR o imágenes ----------
            const grande = $<HTMLDialogElement>('#grande');
            let serie: HTMLElement[] = [];
            let actual = 0;
            function mostrarGrande(elementos: HTMLElement[], desde = 0) {
                serie = elementos;
                actual = desde;
                $('#anterior').hidden = $('#siguiente').hidden = serie.length < 2;
                pintarGrande();
                if (!grande.open) grande.showModal();
            }
            function pintarGrande() {
                $('#grande-contenido').replaceChildren(serie[actual].cloneNode(true));
            }
            const mover = (paso: number) => {
                actual = (actual + paso + serie.length) % serie.length;
                pintarGrande();
            };
            $('#anterior').addEventListener('click', () => mover(-1));
            $('#siguiente').addEventListener('click', () => mover(1));
            $('#cerrar').addEventListener('click', () => grande.close());
            grande.addEventListener('click', (e) => {
                if (e.target === grande) grande.close();
            });
            grande.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') mover(-1);
                if (e.key === 'ArrowRight') mover(1);
            });

            async function qrGrande(url: string, titulo: string) {
                const caja = document.createElement('div');
                caja.className = 'qr-grande';
                caja.innerHTML = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M' });
                const pie = document.createElement('figcaption');
                pie.innerHTML = `<strong></strong><span></span>`;
                pie.querySelector('strong')!.textContent = titulo;
                pie.querySelector('span')!.textContent = url.replace('https://', '');
                caja.append(pie);
                mostrarGrande([caja]);
            }

            // ---------- Links ----------
            for (const tarjeta of document.querySelectorAll<HTMLElement>('.enlace')) {
                const { url = '', titulo = '' } = tarjeta.dataset;
                const compartir = tarjeta.querySelector<HTMLButtonElement>('[data-accion="compartir"]')!;
                compartir.hidden = !navigator.share;
                tarjeta.querySelector('[data-accion="copiar"]')!.addEventListener('click', async (e) => {
                    const boton = e.currentTarget as HTMLButtonElement;
                    try {
                        await navigator.clipboard.writeText(url);
                        boton.textContent = '¡Copiado!';
                    } catch {
                        boton.textContent = 'No se pudo';
                    }
                    setTimeout(() => (boton.textContent = 'Copiar'), 1500);
                });
                compartir.addEventListener('click', () => navigator.share({ title: titulo, url }).catch(() => {}));
                tarjeta.querySelector('[data-accion="qr"]')!.addEventListener('click', () => qrGrande(url, titulo));
            }
            for (const boton of document.querySelectorAll<HTMLElement>('[data-qr-de]')) {
                boton.addEventListener('click', () => qrGrande(boton.dataset.qrDe!, boton.dataset.titulo || ''));
            }

            // ---------- Cooperadora ----------
            interface Item {
                texto: string;
                curso: string;
            }
            interface Cobro {
                nombre: string;
                monto: number;
            }
            // Los de siempre, hasta que se editen; después se guardan con la cooperadora (los ve todo el panel)
            const COBROS_DE_ENTRADA: Cobro[] = [
                { nombre: '', monto: 100 },
                { nombre: '', monto: 150 },
                { nombre: '', monto: 1000 },
            ];
            let cooperadora: { recaudado: number; listado: Item[]; botones?: Cobro[] } = { recaudado: 0, listado: [] };
            let editandoCobros = false;
            const sitio = $('#hoja').dataset.sitio!;
            const nuevo = <K extends keyof HTMLElementTagNameMap>(etiqueta: K, props: Partial<HTMLElementTagNameMap[K]> = {}) =>
                Object.assign(document.createElement(etiqueta), props);

            // Los cursos que ya se escribieron (en el listado o en los vales), para no tipearlos de nuevo
            function sugerirCursos() {
                const cursos = new Set([...cooperadora.listado.map((i) => i.curso), ...vales.map((v) => v.curso)].filter(Boolean));
                $('#cursos-cfp').replaceChildren(...[...cursos].map((c) => nuevo('option', { value: c })));
            }

            // Igual que las consultas: se guarda solo unos segundos después del último cambio
            let esperaCoop = 0;
            function guardarCoopLuego() {
                $('#guardado-coop').textContent = 'sin guardar…';
                clearTimeout(esperaCoop);
                esperaCoop = window.setTimeout(async () => {
                    try {
                        await pedir('/admin/cooperadora', 'PUT', cooperadora);
                        $('#guardado-coop').textContent = 'guardado ✓';
                    } catch (error) {
                        $('#guardado-coop').textContent = 'no se guardó: ' + (error instanceof Error ? error.message : '');
                        guardarCoopLuego();
                    }
                }, 3000);
            }
            addEventListener('beforeunload', (e) => {
                if ($('#guardado-coop').textContent === 'sin guardar…') e.preventDefault();
            });

            function dibujarCooperadora() {
                $<HTMLInputElement>('#recaudado').value = String(cooperadora.recaudado || 0);
                $('#cuenta-listado').textContent = cooperadora.listado.length ? `${cooperadora.listado.length}` : '';
                $('#listado').replaceChildren(
                    ...cooperadora.listado.map((item, i) => {
                        const li = nuevo('li');
                        const texto = nuevo('span', { className: 'item' });
                        texto.append(nuevo('strong', { textContent: item.texto }), item.curso ? ` · ${item.curso}` : '');
                        const subir = nuevo('button', { type: 'button', className: 'borrar', textContent: '↑', title: 'Subir' });
                        subir.disabled = i === 0;
                        subir.addEventListener('click', () => {
                            [cooperadora.listado[i - 1], cooperadora.listado[i]] = [cooperadora.listado[i], cooperadora.listado[i - 1]];
                            dibujarCooperadora();
                            guardarCoopLuego();
                        });
                        const borrar = nuevo('button', { type: 'button', className: 'borrar', textContent: '✕', title: 'Borrar' });
                        borrar.addEventListener('click', () => {
                            cooperadora.listado.splice(i, 1);
                            dibujarCooperadora();
                            guardarCoopLuego();
                        });
                        li.append(texto, subir, borrar);
                        return li;
                    }),
                );
                sugerirCursos();
                dibujarCobros();
            }
            $('#recaudado').addEventListener('input', () => {
                cooperadora.recaudado = Math.max(0, Math.round(Number($<HTMLInputElement>('#recaudado').value) || 0));
                guardarCoopLuego();
            });

            // ---------- Cobros rápidos: botones que suman un monto, editables ----------
            const pesos = (n: number) => '$' + n.toLocaleString('es-AR');
            function dibujarCobros() {
                const botones = cooperadora.botones ?? COBROS_DE_ENTRADA;
                $('#botones-cobro').replaceChildren(
                    ...botones.map((cobro, i) => {
                        const boton = nuevo('button', { type: 'button', className: 'cobro' });
                        boton.append(nuevo('strong', { textContent: '+' + pesos(cobro.monto) }));
                        if (cobro.nombre) boton.append(nuevo('small', { textContent: cobro.nombre }));
                        if (editandoCobros) {
                            boton.classList.add('cobro--borrar');
                            boton.title = 'Borrar este botón';
                            boton.append(nuevo('span', { className: 'cobro__x', textContent: '✕' }));
                            boton.addEventListener('click', () => {
                                cooperadora.botones = botones.filter((_, j) => j !== i);
                                dibujarCobros();
                                guardarCoopLuego();
                            });
                        } else {
                            boton.addEventListener('click', () => {
                                cooperadora.recaudado += cobro.monto;
                                $<HTMLInputElement>('#recaudado').value = String(cooperadora.recaudado);
                                // un destello, para saber que tomó el toque
                                boton.classList.remove('cobro--sumo');
                                void boton.offsetWidth;
                                boton.classList.add('cobro--sumo');
                                guardarCoopLuego();
                            });
                        }
                        return boton;
                    }),
                );
                if (!botones.length) $('#botones-cobro').append(nuevo('small', { className: 'nota', textContent: 'Sin botones: agregá uno con ✏️ Editar.' }));
            }
            $('#editar-cobros').addEventListener('click', () => {
                editandoCobros = !editandoCobros;
                $('#editar-cobros').setAttribute('aria-pressed', String(editandoCobros));
                $('#editar-cobros').textContent = editandoCobros ? '✓ Listo' : '✏️ Editar';
                $('#form-cobro').hidden = !editandoCobros;
                dibujarCobros();
            });
            $('#form-cobro').addEventListener('submit', (e) => {
                e.preventDefault();
                const monto = Math.round(Number($<HTMLInputElement>('#cobro-monto').value) || 0);
                if (monto <= 0) return;
                const botones = [...(cooperadora.botones ?? COBROS_DE_ENTRADA)];
                if (botones.length >= 12) {
                    alert('Hasta 12 botones: borrá alguno primero.');
                    return;
                }
                botones.push({ nombre: $<HTMLInputElement>('#cobro-nombre').value.trim(), monto });
                botones.sort((a, b) => a.monto - b.monto);
                cooperadora.botones = botones;
                $<HTMLInputElement>('#cobro-nombre').value = '';
                $<HTMLInputElement>('#cobro-monto').value = '';
                dibujarCobros();
                guardarCoopLuego();
                $('#cobro-nombre').focus();
            });
            $('#form-listado').addEventListener('submit', (e) => {
                e.preventDefault();
                const texto = $<HTMLInputElement>('#item-texto').value.trim();
                if (!texto) return;
                cooperadora.listado.push({ texto, curso: $<HTMLInputElement>('#item-curso').value.trim() });
                $<HTMLInputElement>('#item-texto').value = '';
                dibujarCooperadora();
                guardarCoopLuego();
                $('#item-texto').focus();
            });

            // ---------- Vales ----------
            interface Vale {
                id: string;
                quien: string;
                curso: string;
                que: string;
                cantidad: string;
                mensaje: string;
                creado: string;
            }
            let vales: Vale[] = [];
            const MENSAJE_VALE = '¡Gracias por sumarte a la Expo! Tu donación ayuda a la cooperadora del CFP 401 y a todos sus cursos.';
            const linkVale = (v: Vale) => `${sitio}expo/vale/#${v.id}`;
            const campoVale = (nombre: string) => $<HTMLInputElement>('#vale-' + nombre);

            function limpiarFormVale() {
                for (const c of ['id', 'quien', 'curso', 'que', 'cantidad']) campoVale(c).value = '';
                campoVale('mensaje').value = MENSAJE_VALE;
                $('#vale-guardar').textContent = 'Crear vale';
                $('#vale-cancelar').hidden = true;
            }
            limpiarFormVale();
            $('#vale-cancelar').addEventListener('click', limpiarFormVale);

            $('#form-vale').addEventListener('submit', async (e) => {
                e.preventDefault();
                const datos = Object.fromEntries(['id', 'quien', 'curso', 'que', 'cantidad', 'mensaje'].map((c) => [c, campoVale(c).value.trim()]));
                $('#vale-estado').textContent = 'Guardando…';
                try {
                    const { vale } = await pedir('/admin/vales', 'PUT', datos);
                    const i = vales.findIndex((v) => v.id === vale.id);
                    if (i >= 0) vales[i] = vale;
                    else vales.push(vale);
                    limpiarFormVale();
                    dibujarVales();
                    $('#vale-estado').textContent = i >= 0 ? 'Vale corregido ✓ (el link es el mismo)' : 'Vale creado ✓ Mandale el link:';
                    document.querySelector(`[data-vale="${vale.id}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } catch (error) {
                    $('#vale-estado').textContent = error instanceof Error ? error.message : 'No se pudo';
                }
            });

            function dibujarVales() {
                $('#sin-vales').hidden = vales.length > 0;
                $('#lista-vales').replaceChildren(
                    ...[...vales].reverse().map((v) => {
                        const tarjeta = nuevo('article', { className: 'tarjeta enlace' });
                        tarjeta.dataset.vale = v.id;
                        tarjeta.append(
                            nuevo('span', { className: 'para', textContent: v.curso || 'Sin curso' }),
                            nuevo('strong', { textContent: v.quien }),
                            nuevo('span', { textContent: (v.cantidad ? `${v.cantidad} × ` : '') + v.que }),
                            nuevo('code', { textContent: linkVale(v).replace('https://', '') }),
                        );
                        const botones = nuevo('div', { className: 'botones' });
                        const boton = (texto: string, accion: () => void) => {
                            const b = nuevo('button', { type: 'button', textContent: texto });
                            b.addEventListener('click', accion);
                            botones.append(b);
                            return b;
                        };
                        const abrir = nuevo('a', { href: linkVale(v), target: '_blank', rel: 'noopener', textContent: 'Ver' });
                        botones.append(abrir);
                        const copiar = boton('Copiar', async () => {
                            try {
                                await navigator.clipboard.writeText(linkVale(v));
                                copiar.textContent = '¡Copiado!';
                            } catch {
                                copiar.textContent = 'No se pudo';
                            }
                            setTimeout(() => (copiar.textContent = 'Copiar'), 1500);
                        });
                        boton('WhatsApp', () => {
                            const texto = `¡Hola! Este es tu vale de donación para la Expo del CFP 401. ¡Muchas gracias! ${linkVale(v)}`;
                            open(`https://wa.me/?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
                        });
                        boton('QR', () => qrGrande(linkVale(v), `Vale de ${v.quien}`));
                        boton('Corregir', () => {
                            for (const c of ['id', 'quien', 'curso', 'que', 'cantidad', 'mensaje'] as const) campoVale(c).value = v[c] || '';
                            $('#vale-guardar').textContent = 'Guardar cambios';
                            $('#vale-cancelar').hidden = false;
                            $('#form-vale').scrollIntoView({ behavior: 'smooth' });
                        });
                        boton('Borrar', async () => {
                            if (!confirm(`¿Borrar el vale de ${v.quien}? El link deja de andar.`)) return;
                            try {
                                await pedir('/admin/vales/' + v.id, 'DELETE');
                                vales = vales.filter((x) => x.id !== v.id);
                                dibujarVales();
                            } catch (error) {
                                alert(error instanceof Error ? error.message : 'No se pudo');
                            }
                        }).classList.add('peligro');
                        tarjeta.append(botones);
                        return tarjeta;
                    }),
                );
                sugerirCursos();
            }

            // ---------- Encuesta 2027 ----------
            let respuestas: Respuesta[] = [];
            const nombreDe = (lista: readonly { codigo: string; texto: string }[], codigo: string) => lista.find((o) => o.codigo === codigo)?.texto || codigo;
            // Las respuestas de prueba de antes ("mañana", "tarde"…) no son bloques: se ignoran sus horarios
            const normalizar = (lista: Respuesta[]) => lista.map((r) => ({ ...r, h: (r.h || []).filter((m) => typeof m === 'number') }));

            function conteo(titulo: string, opciones: readonly { codigo: string; texto: string }[], valores: (r: Respuesta) => string[]) {
                const caja = nuevo('div', { className: 'tarjeta' });
                caja.append(nuevo('h3', { textContent: titulo }));
                const total = respuestas.length || 1;
                const lista = nuevo('ul', { className: 'barras' });
                for (const o of opciones) {
                    const n = respuestas.filter((r) => valores(r).includes(o.codigo)).length;
                    const li = nuevo('li');
                    const barra = nuevo('i');
                    barra.style.width = `${(n / total) * 100}%`;
                    li.append(nuevo('span', { textContent: o.texto }), nuevo('b', { textContent: String(n) }), barra);
                    lista.append(li);
                }
                caja.append(lista);
                return caja;
            }

            // ¿Sus bloques, juntos, cubren de `desde` a `hasta` sin huecos?
            function puede(r: Respuesta, desde: number, hasta: number) {
                let hastaDonde = desde;
                for (const inicio of [...r.h].sort((a, b) => a - b)) {
                    if (inicio > hastaDonde) break;
                    hastaDonde = Math.max(hastaDonde, inicio + HORARIO.duracion);
                    if (hastaDonde >= hasta) return true;
                }
                return hastaDonde >= hasta;
            }

            function dibujarEncuesta() {
                const n = respuestas.length;
                $('#encuesta-total').textContent = `${n} ${n === 1 ? 'respuesta' : 'respuestas'}`;
                // Las mejores clases posibles: para cada día y cada hora de empezar, cuántas personas
                // pueden la clase ENTERA (sus bloques juntos la cubren de punta a punta: 13:20-16:40 y
                // 15:00-18:20 sirven para una de 14:00 a 17:20)
                const candidatas: { dia: string; inicio: number; cuantos: number }[] = [];
                for (const d of DIAS) {
                    for (let inicio = HORARIO.desde; inicio <= HORARIO.hasta - HORARIO.duracion; inicio += HORARIO.paso) {
                        const cuantos = respuestas.filter((r) => r.d.includes(d.codigo) && puede(r, inicio, inicio + HORARIO.duracion)).length;
                        if (cuantos) candidatas.push({ dia: d.texto, inicio, cuantos });
                    }
                }
                candidatas.sort((a, b) => b.cuantos - a.cuantos || a.inicio - b.inicio);
                const mejores = nuevo('div', { className: 'tarjeta' });
                mejores.append(nuevo('h3', { textContent: 'Mejores horarios para la clase' }), nuevo('p', { className: 'nota', textContent: 'Quiénes pueden la clase entera (3 h 20) ese día.' }));
                const listaMejores = nuevo('ol', { className: 'mejores' });
                listaMejores.append(
                    ...candidatas.slice(0, 8).map((c) => {
                        const li = nuevo('li');
                        li.append(nuevo('strong', { textContent: `${c.dia} ${franja(c.inicio)}` }), ` · ${c.cuantos} ${c.cuantos === 1 ? 'persona' : 'personas'}`);
                        return li;
                    }),
                );
                if (!candidatas.length) listaMejores.append(nuevo('li', { className: 'nota', textContent: 'Todavía nada.' }));
                mejores.append(listaMejores);
                $('#encuesta-conteos').replaceChildren(
                    // "Los dos" cuenta para los dos cursos y también se muestra aparte
                    conteo('Curso', CURSOS, (r) => (r.c === 'los-dos' ? ['ia', 'web', 'los-dos'] : [r.c])),
                    conteo('Días', DIAS, (r) => r.d),
                    mejores,
                );
                // El cruce: en cada casillero, cuántas personas pueden ese día a esa hora
                const HORAS = Array.from({ length: (HORARIO.hasta - HORARIO.desde) / 60 }, (_, i) => HORARIO.desde + i * 60);
                const enLaHora = (r: Respuesta, dia: string, h: number) => r.d.includes(dia) && puede(r, h, h + 60);
                const tabla = $('#encuesta-cruce');
                const max = Math.max(1, ...DIAS.flatMap((d) => HORAS.map((h) => respuestas.filter((r) => enLaHora(r, d.codigo, h)).length)));
                const cabeza = nuevo('tr');
                cabeza.append(nuevo('th'), ...HORAS.map((h) => nuevo('th', { textContent: String(h / 60) })));
                tabla.replaceChildren(
                    cabeza,
                    ...DIAS.map((d) => {
                        const fila = nuevo('tr');
                        fila.append(nuevo('th', { textContent: d.texto }));
                        for (const h of HORAS) {
                            const cuantos = respuestas.filter((r) => enLaHora(r, d.codigo, h)).length;
                            const celda = nuevo('td', { textContent: String(cuantos) });
                            celda.style.setProperty('--intensidad', String(cuantos / max));
                            fila.append(celda);
                        }
                        return fila;
                    }),
                );
                const conContacto = respuestas.filter((r) => r.n || r.w);
                $('#encuesta-cuantos-contacto').textContent = `${conContacto.length}`;
                $('#encuesta-contactos').replaceChildren(
                    ...conContacto.map((r) => {
                        const li = nuevo('li');
                        li.append(nuevo('strong', { textContent: r.n || 'Sin nombre' }), ` · ${nombreDe(CURSOS, r.c)}`);
                        if (r.w) li.append(' · ', nuevo('a', { href: `https://wa.me/${r.w.length === 10 ? '549' + r.w : r.w}`, target: '_blank', rel: 'noopener', textContent: r.w }));
                        return li;
                    }),
                );
                if (!conContacto.length) $('#encuesta-contactos').append(nuevo('li', { className: 'nota', textContent: 'Nadie todavía.' }));
            }

            $('#encuesta-actualizar').addEventListener('click', async (e) => {
                const boton = e.currentTarget as HTMLButtonElement;
                boton.disabled = true;
                try {
                    respuestas = normalizar((await pedir('/admin/encuesta')).respuestas);
                    dibujarEncuesta();
                } catch (error) {
                    alert(error instanceof Error ? error.message : 'No se pudo');
                }
                boton.disabled = false;
            });

            $('#encuesta-csv').addEventListener('click', () => {
                const celda = (s: string) => `"${String(s ?? '').replace(/"/g, '""')}"`;
                const filas = [
                    ['fecha', 'curso', 'dias', 'horarios', 'nombre', 'whatsapp', 'comentario'],
                    ...respuestas.map((r) => [
                        r.f,
                        nombreDe(CURSOS, r.c),
                        r.d.map((d) => nombreDe(DIAS, d)).join(' '),
                        r.h.map(franja).join(' / '),
                        r.n || '',
                        r.w || '',
                        r.k || '',
                    ]),
                ];
                // Con BOM, para que Excel lea bien las tildes
                const csv = '﻿' + filas.map((f) => f.map(celda).join(';')).join('\r\n');
                const a = nuevo('a', { href: URL.createObjectURL(new Blob([csv], { type: 'text/csv' })), download: 'encuesta-cursos-2027.csv' });
                a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 1000);
            });

            // ---------- Galería (llega del Worker) ----------
            function dibujarGaleria(imagenes: Imagen[]) {
                $('#sin-imagenes').hidden = imagenes.length > 0;
                const grupos = [...new Set(imagenes.map((i) => i.grupo || 'Otras'))];
                const figuras: HTMLElement[] = [];
                $('#galeria').replaceChildren(
                    ...grupos.map((grupo) => {
                        const caja = document.createElement('div');
                        const titulo = document.createElement('h4');
                        titulo.textContent = grupo;
                        const grilla = document.createElement('div');
                        grilla.className = 'miniaturas';
                        for (const img of imagenes.filter((i) => (i.grupo || 'Otras') === grupo)) {
                            const figura = document.createElement('figure');
                            const foto = document.createElement('img');
                            foto.src = `data:${img.tipo || 'image/webp'};base64,${img.datos}`;
                            foto.alt = img.titulo || img.id;
                            foto.loading = 'lazy';
                            const pie = document.createElement('figcaption');
                            pie.textContent = img.titulo || img.id;
                            figura.append(foto, pie);
                            const indice = figuras.push(figura) - 1;
                            const boton = document.createElement('button');
                            boton.type = 'button';
                            boton.className = 'miniatura';
                            boton.append(figura);
                            boton.addEventListener('click', () => mostrarGrande(figuras, indice));
                            grilla.append(boton);
                        }
                        caja.append(titulo, grilla);
                        return caja;
                    }),
                );
            }

            // Con la clave ya puesta en esta pestaña (o en el operador), entra solo
            try {
                const guardada = sessionStorage.getItem('stand:admin');
                if (guardada) {
                    $<HTMLInputElement>('#clave').value = guardada;
                    entrar(guardada);
                }
            } catch {
                /* sin sessionStorage */
            }
        </script>
    </body>
</html>

