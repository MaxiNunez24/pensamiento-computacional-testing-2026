---
/**
 * El cartón del Bingo en el celular: /expo/bingo/?r=RONDA&t=6-30
 *
 * Se llega con el QR de la ronda, que está en la lona. El cartón lo entrega el Worker, firmado
 * (ver src/scripts/bingo-cartones.js), y queda guardado en el celular: si se recarga la página, es el
 * mismo. Las bolillas se miran en la pantalla grande y los números se marcan tocándolos, como en
 * papel: el celular no consulta nada mientras se juega.
 *
 * Con &imprimir=1 es la página del celular de la caja: arma de una vez una TIRA de 57 mm (384
 * puntos, lo que imprime la térmica) con todos los cartones que se vendieron, para mandarla a Fun
 * Print en una sola impresión. Los que se imprimieron quedan en ese celular (localStorage), por si
 * hay que reimprimir uno.
 *
 * Con ?p=… es el QR chiquito de un cartón impreso: muestra ESE cartón para marcarlo en el celular,
 * sin pedirle nada al Worker (ver linkDePapel en src/scripts/bingo-expo.ts).
 *
 * Desde la primera bolilla, el Worker ya no da cartones de esa ronda (responde 409): igual no valdrían.
 */
import Expo from '../../../layouts/Expo.astro';
---

<Expo titulo="Tu cartón · Bingo de la Expo CFP 401" descripcion="Tu cartón para el Bingo del stand de Pensamiento Computacional.">
  <main class="hoja">
    <header>
      <p class="etiqueta">Expo CFP 401 · Pensamiento Computacional</p>
      <h1>Bingo <span class="ronda" data-ronda></span></h1>
    </header>

    <p class="estado" data-estado aria-live="polite">Buscando tu cartón…</p>

    <!-- ===== La ronda ya terminó (o la Expo): el papel queda de recuerdo ===== -->
    <section class="gracias" data-gracias hidden>
      <p class="gracias-emoji" aria-hidden="true">🎉</p>
      <h2>¡Gracias por participar!</h2>
      <p>Gracias por venir a la <strong>Expo del CFP N°401</strong> y al stand de
        <strong>Pensamiento Computacional</strong>.</p>
      <p>Los esperamos el año que viene en las <strong>inscripciones</strong> o en la próxima Expo.</p>
      <button type="button" class="boton boton--borde boton--chico" data-ver-igual>Ver mi cartón igual</button>
    </section>

    <!-- ===== Para jugar ===== -->
    <section class="juego" data-juego hidden>
      <ol class="carton" data-carton></ol>
      <p class="ayuda">Mirá las bolillas en la pantalla grande y <strong>tocá tus números</strong> para marcarlos.</p>
      <button type="button" class="boton boton--borde boton--chico" data-cambiar hidden></button>
      <div class="codigo-caja">
        <p>Si completás todos, gritá <strong>¡BINGO!</strong> y mostrá tu código:</p>
        <p class="codigo" data-codigo></p>
      </div>
    </section>

    <!-- ===== Para imprimir (el celular del stand) ===== -->
    <section class="imprimir" data-imprimir hidden>
      <div class="tanda">
        <label for="cuantos">¿Cuántos cartones?</label>
        <div class="contador">
          <button type="button" class="boton boton--borde" data-menos aria-label="Uno menos">−</button>
          <input id="cuantos" type="number" min="1" max="30" value="1" inputmode="numeric" />
          <button type="button" class="boton boton--borde" data-mas aria-label="Uno más">+</button>
        </div>
        <button type="button" class="boton" data-nuevo>Armar los cartones</button>
        <p class="ayuda">Salen todos en una sola tira, separados por una línea para cortar. Cada uno tiene su QR para jugarlo también en el celular.</p>
      </div>
      <img class="vista" data-vista alt="" hidden />
      <div class="acciones" data-acciones hidden>
        <button type="button" class="boton" data-compartir>Mandar a Fun Print</button>
        <a class="boton boton--borde" data-bajar download>Guardar la imagen</a>
      </div>
      <p class="ayuda" data-cuantos></p>
      <div class="historial" data-historial hidden>
        <h2>Ya impresos <small>en este celular</small></h2>
        <ol data-impresos></ol>
        <button type="button" class="boton boton--borde boton--chico" data-borrar-historial>Borrar el historial</button>
      </div>
    </section>
  </main>
</Expo>

<script>
  import QRCode from 'qrcode';
  import { RONDA_OK, TAMANOS } from '../../../scripts/bingo-cartones.js';
  import { WORKER, describirTamano, leerPapel, linkDePapel } from '../../../scripts/bingo-expo';
  import { renglonGrafica } from '../../../scripts/termica';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const parametros = new URLSearchParams(location.search);
  // ?p=… es el QR de un cartón impreso: trae el cartón entero y no se le pide nada al Worker
  const papel = leerPapel(parametros.get('p') || '');
  const ronda = papel?.ronda ?? (parametros.get('r') || '').toUpperCase();
  const tamano = papel?.tamano ?? (parametros.get('t') || '');
  const imprimir = !papel && parametros.has('imprimir');

  interface Carton {
    codigo: string;
    numeros: number[];
    marcados?: number[];
    cambios?: number;
  }

  // Cada persona puede cambiar su cartón dos veces por ronda. El límite vive en el celular: quien
  // lo saltee (con otra pestaña, por ejemplo) no gana nada, porque un cartón pedido después de la
  // primera bolilla no vale (lo rechaza el operador al validar).
  const CAMBIOS = 2;

  const estado = $('[data-estado]');

  // La ronda ya tiene bolillas: el Worker no da más cartones (y el operador no los aceptaría)
  class RondaEmpezada extends Error {}

  async function pedirCarton(): Promise<Carton> {
    const url = new URL(WORKER + '/bingo/carton');
    url.searchParams.set('ronda', ronda);
    url.searchParams.set('tamano', tamano);
    const r = await fetch(url);
    const datos = await r.json().catch(() => ({}));
    if (r.status === 409 && datos.empezo) throw new RondaEmpezada(datos.error);
    if (!r.ok) throw new Error(datos.error || 'No se pudo');
    return { codigo: datos.codigo, numeros: datos.numeros };
  }

  // ---------- Para jugar ----------
  // El de papel se guarda aparte: el mismo celular puede tener uno digital y otro impreso
  const guardado = papel ? `bingo:papel:${papel.codigo}` : `bingo:carton:${ronda}-${tamano}`;

  function guardar(carton: Carton) {
    try {
      localStorage.setItem(guardado, JSON.stringify(carton));
    } catch {
      /* sin guardar: igual se juega */
    }
  }

  // El botón se va apenas se marca un número: si ya salen bolillas, un cartón nuevo no valdría
  function mostrarCambiar(carton: Carton) {
    const boton = $<HTMLButtonElement>('[data-cambiar]');
    const quedan = CAMBIOS - (carton.cambios ?? 0);
    // El impreso no se cambia: es el que se pagó
    boton.hidden = !!papel || quedan <= 0 || (carton.marcados?.length ?? 0) > 0;
    boton.textContent = `Cambiar mi cartón (te ${quedan === 1 ? 'queda 1' : `quedan ${quedan}`})`;
  }

  function dibujar(carton: Carton) {
    const lista = $('[data-carton]');
    lista.style.setProperty('--cantidad', String(carton.numeros.length));
    lista.replaceChildren(
      ...carton.numeros.map((n) => {
        const li = document.createElement('li');
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = String(n);
        boton.setAttribute('aria-pressed', String(carton.marcados?.includes(n) ?? false));
        boton.addEventListener('click', () => {
          const marcados = new Set(carton.marcados ?? []);
          if (marcados.has(n)) marcados.delete(n);
          else marcados.add(n);
          carton.marcados = [...marcados];
          boton.setAttribute('aria-pressed', String(marcados.has(n)));
          guardar(carton);
          mostrarCambiar(carton);
          const lleno = carton.numeros.every((x) => marcados.has(x));
          $('.codigo-caja').classList.toggle('lleno', lleno);
        });
        li.append(boton);
        return li;
      }),
    );
    $('[data-codigo]').textContent = carton.codigo;
    $('.codigo-caja').classList.toggle('lleno', carton.numeros.every((x) => carton.marcados?.includes(x)));
    mostrarCambiar(carton);
  }

  async function jugar() {
    let carton: Carton | null = null;
    try {
      carton = JSON.parse(localStorage.getItem(guardado) || 'null');
    } catch {
      /* nada */
    }
    if (!carton) {
      carton = papel ? { codigo: papel.codigo, numeros: papel.numeros } : await pedirCarton();
      guardar(carton);
    }
    estado.textContent = papel ? `Tu cartón impreso · ${describirTamano(tamano)}` : describirTamano(tamano);
    $('[data-juego]').hidden = false;
    dibujar(carton);

    const cambiar = $<HTMLButtonElement>('[data-cambiar]');
    cambiar.addEventListener('click', async () => {
      if (!carton) return;
      if (!confirm('¿Cambiar el cartón? Hacelo antes de la primera bolilla: si la ronda ya arrancó, el cartón nuevo no vale.')) return;
      cambiar.disabled = true;
      try {
        const nuevo = await pedirCarton();
        carton = { ...nuevo, cambios: (carton.cambios ?? 0) + 1 };
        guardar(carton);
        dibujar(carton);
      } catch (error) {
        if (error instanceof RondaEmpezada) {
          // Ya no se puede cambiar en esta ronda: el botón no vuelve
          carton.cambios = CAMBIOS;
          guardar(carton);
          mostrarCambiar(carton);
          estado.textContent = 'La ronda ya arrancó: tu cartón de siempre sigue valiendo.';
        } else {
          estado.textContent = 'No se pudo cambiar el cartón. ¿Tenés internet? El de siempre sigue valiendo.';
        }
      } finally {
        cambiar.disabled = false;
      }
    });
  }

  // ---------- Para imprimir: una tira de 57 mm con todos los cartones ----------
  // 384 puntos de ancho es lo que imprime la térmica. Solo negro sobre blanco: los grises salen
  // como puntitos y los números se leen peor. Todos van en UNA imagen, así Fun Print imprime una
  // sola vez y la tira se corta con la sierrita de la impresora.
  const ANCHO = 384;
  const MODULO = 3; // cada cuadradito del QR, en puntos (3 = 0,37 mm: el celular lo lee bien)

  interface Impreso extends Carton {
    ronda: string;
    tamano: string;
    hora: number;
  }

  const qrDe = (carton: Impreso) =>
    QRCode.create(linkDePapel(carton.codigo, carton.ronda, carton.tamano, carton.numeros), { errorCorrectionLevel: 'L' }).modules;

  // El QR, cuadradito por cuadradito: sin suavizado, que en la térmica se vería borroso
  function dibujarQR(c: CanvasRenderingContext2D, modulos: ReturnType<typeof qrDe>, x: number, y: number) {
    const lado = modulos.size;
    c.fillStyle = '#000';
    for (let fila = 0; fila < lado; fila++) {
      for (let col = 0; col < lado; col++) {
        if (modulos.data[fila * lado + col]) c.fillRect(x + col * MODULO, y + fila * MODULO, MODULO, MODULO);
      }
    }
  }

  function altoDeCarton(carton: Impreso) {
    const celda = Math.floor(ANCHO / carton.numeros.length);
    return 34 + celda + 12 + qrDe(carton).size * MODULO + 8;
  }

  function dibujarCarton(c: CanvasRenderingContext2D, carton: Impreso, y0: number) {
    const cantidad = carton.numeros.length;
    const celda = Math.floor(ANCHO / cantidad);
    c.fillStyle = '#000';
    c.strokeStyle = '#000';
    c.textBaseline = 'middle';
    c.font = '700 22px system-ui, sans-serif';
    c.textAlign = 'left';
    c.fillText('BINGO · CFP 401', 4, y0 + 16);
    c.textAlign = 'right';
    c.fillText('Ronda ' + carton.ronda, ANCHO - 4, y0 + 16);
    c.textAlign = 'center';
    c.lineWidth = 4;
    carton.numeros.forEach((n, i) => {
      const x = (ANCHO - celda * cantidad) / 2 + celda * i + celda / 2;
      const y = y0 + 34 + celda / 2;
      c.beginPath();
      c.arc(x, y, celda / 2 - 4, 0, Math.PI * 2);
      c.stroke();
      c.font = `800 ${Math.round(celda * 0.5)}px system-ui, sans-serif`;
      c.fillText(String(n), x, y + 2);
    });
    // Abajo: el código a la izquierda (es lo que se dicta al cantar Bingo) y el QR a la derecha
    const yAbajo = y0 + 34 + celda + 12;
    const modulos = qrDe(carton);
    const lado = modulos.size * MODULO;
    dibujarQR(c, modulos, ANCHO - 4 - lado, yAbajo);
    const xTexto = (ANCHO - 4 - lado) / 2;
    c.fillStyle = '#000';
    c.textAlign = 'center';
    c.font = '700 30px ui-monospace, Consolas, monospace';
    c.fillText(carton.codigo, xTexto, yAbajo + lado / 2 - 18);
    c.font = '600 17px system-ui, sans-serif';
    c.fillText('Jugalo en el celular →', xTexto, yAbajo + lado / 2 + 14);
    c.fillText('¡BINGO! y mostrá el código', xTexto, yAbajo + lado / 2 + 36);
  }

  // La línea para cortar entre cartón y cartón
  const CORTE = 28;
  function dibujarCorte(c: CanvasRenderingContext2D, y: number) {
    c.save();
    c.setLineDash([10, 8]);
    c.lineWidth = 2;
    c.beginPath();
    c.moveTo(0, y + CORTE / 2);
    c.lineTo(ANCHO, y + CORTE / 2);
    c.stroke();
    c.restore();
  }

  // Cada cartón se corta y se lleva por separado: el agradecimiento a La Gráfica va debajo de cada uno
  const PIE = 34;
  async function imagen(cartones: Impreso[]) {
    const altos = cartones.map((x) => altoDeCarton(x) + PIE);
    const alto = altos.reduce((a, b) => a + b, 0) + CORTE * (cartones.length - 1);
    const lienzo = document.createElement('canvas');
    lienzo.width = ANCHO;
    lienzo.height = alto;
    const c = lienzo.getContext('2d')!;
    c.fillStyle = '#fff';
    c.fillRect(0, 0, ANCHO, alto);
    let y = 0;
    for (const [i, carton] of cartones.entries()) {
      if (i > 0) {
        dibujarCorte(c, y);
        y += CORTE;
      }
      dibujarCarton(c, carton, y);
      await renglonGrafica(c, ANCHO, y + altos[i] - PIE / 2, true);
      y += altos[i];
    }
    return lienzo;
  }
  const HISTORIAL = 'bingo:impresos';
  let archivo: File | null = null;

  function leerHistorial(): Impreso[] {
    try {
      return JSON.parse(localStorage.getItem(HISTORIAL) || '[]');
    } catch {
      return [];
    }
  }

  // Los de esta ronda primero; se guardan los últimos 200
  function dibujarHistorial() {
    const lista = leerHistorial();
    const deEsta = lista.filter((x) => x.ronda === ronda).length;
    $('[data-cuantos]').textContent = deEsta ? `Cartones de esta ronda: ${deEsta}` : '';
    $('[data-historial]').hidden = lista.length === 0;
    const orden = [...lista].sort((a, b) => Number(b.ronda === ronda) - Number(a.ronda === ronda) || b.hora - a.hora);
    $('[data-impresos]').replaceChildren(
      ...orden.map((x) => {
        const li = document.createElement('li');
        if (x.ronda !== ronda) li.className = 'otra';
        const texto = document.createElement('span');
        const hora = new Date(x.hora).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
        texto.innerHTML = '<strong></strong><small></small>';
        texto.querySelector('strong')!.textContent = x.codigo;
        texto.querySelector('small')!.textContent = `Ronda ${x.ronda} · ${hora} · ${x.numeros.join(' ')}`;
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.className = 'boton boton--borde boton--chico';
        boton.textContent = 'Reimprimir';
        boton.addEventListener('click', () => mostrarImagen([{ ...x, tamano: x.tamano || tamano }]));
        li.append(texto, boton);
        return li;
      }),
    );
  }

  async function mostrarImagen(cartones: Impreso[]) {
    const lienzo = await imagen(cartones);
    const blob = await new Promise<Blob>((ok) => lienzo.toBlob((b) => ok(b!), 'image/png'));
    const nombre = cartones.length === 1 ? cartones[0].codigo : `${cartones.length}-cartones`;
    archivo = new File([blob], `bingo-${cartones[0].ronda}-${nombre}.png`, { type: 'image/png' });
    const url = URL.createObjectURL(blob);
    const vista = $<HTMLImageElement>('[data-vista]');
    vista.src = url;
    vista.alt = cartones.map((x) => `Cartón ${x.codigo}: ${x.numeros.join(', ')}`).join('. ');
    vista.hidden = false;
    const bajar = $<HTMLAnchorElement>('[data-bajar]');
    bajar.href = url;
    bajar.download = archivo.name;
    $('[data-acciones]').hidden = false;
    $('[data-compartir]').hidden = !navigator.canShare?.({ files: [archivo] });
    vista.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  const cuantos = $<HTMLInputElement>('#cuantos');
  const MAXIMO_TANDA = 30;
  const leerCuantos = () => Math.min(MAXIMO_TANDA, Math.max(1, Math.round(Number(cuantos.value) || 1)));
  $('[data-menos]').addEventListener('click', () => (cuantos.value = String(Math.max(1, leerCuantos() - 1))));
  $('[data-mas]').addEventListener('click', () => (cuantos.value = String(Math.min(MAXIMO_TANDA, leerCuantos() + 1))));

  // Los pide de a uno, como si fueran varios celulares: el Worker firma cada uno y no guarda nada.
  // Si se corta a mitad de camino, arma la tira con los que llegaron y avisa.
  async function tanda() {
    const boton = $<HTMLButtonElement>('[data-nuevo]');
    const total = leerCuantos();
    cuantos.value = String(total);
    boton.disabled = true;
    const llegaron: Impreso[] = [];
    let problema = '';
    for (let i = 0; i < total; i++) {
      estado.textContent = `Pidiendo ${total === 1 ? 'el cartón' : `los cartones: ${i + 1} de ${total}`}…`;
      try {
        const carton = await pedirCarton();
        llegaron.push({ codigo: carton.codigo, numeros: carton.numeros, ronda, tamano, hora: Date.now() });
      } catch (error) {
        problema =
          error instanceof RondaEmpezada
            ? 'Esta ronda ya arrancó: los cartones nuevos son para la próxima (escaneá el QR nuevo del operador).'
            : '¿Hay internet? Cuando vuelva la señal, tocá otra vez "Armar los cartones".';
        // Lo que falta queda puesto, para pedirlo de nuevo con un toque (salvo que la ronda ya arrancó)
        if (!(error instanceof RondaEmpezada) && llegaron.length) cuantos.value = String(total - llegaron.length);
        break;
      }
    }
    if (llegaron.length) {
      try {
        localStorage.setItem(HISTORIAL, JSON.stringify([...leerHistorial(), ...llegaron].slice(-200)));
      } catch {
        /* sin historial: se imprime igual */
      }
      await mostrarImagen(llegaron);
      dibujarHistorial();
    }
    estado.textContent = problema
      ? llegaron.length
        ? `Llegaron ${llegaron.length} de ${total} (ya están en la tira, para imprimir). Faltan ${total - llegaron.length}. ${problema}`
        : 'No se pudo pedir ningún cartón. ' + problema
      : `${llegaron.length === 1 ? 'Listo el cartón' : `Listos los ${llegaron.length} cartones`} · ${describirTamano(tamano)}`;
    boton.disabled = false;
  }

  $('[data-nuevo]').addEventListener('click', tanda);
  $('[data-borrar-historial]').addEventListener('click', () => {
    if (!confirm('¿Borrar la lista de cartones impresos de este celular?')) return;
    try {
      localStorage.removeItem(HISTORIAL);
    } catch {
      /* nada */
    }
    dibujarHistorial();
  });
  $('[data-compartir]').addEventListener('click', () => {
    if (archivo) navigator.share({ files: [archivo] }).catch(() => {});
  });

  // ---------- Arranque ----------
  if (!RONDA_OK.test(ronda) || !TAMANOS.includes(tamano)) {
    estado.textContent = 'Este no es el QR de una ronda. Escaneá el de la pantalla grande del stand.';
  } else {
    $('[data-ronda]').textContent = '· Ronda ' + ronda;
    if (imprimir) {
      estado.textContent = describirTamano(tamano);
      $('[data-imprimir]').hidden = false;
      dibujarHistorial();
    } else {
      terminada().then((fin) => {
        if (fin) return agradecer();
        jugar().catch((error) => {
          estado.textContent =
            error instanceof RondaEmpezada
              ? error.message
              : 'No pude traer tu cartón. ¿Tenés internet? Si no, pedí uno impreso en el stand.';
        });
        // Quien vuelve a la pestaña más tarde, con la ronda ya jugada, también ve el agradecimiento
        document.addEventListener('visibilitychange', async () => {
          if (document.visibilityState === 'visible' && !$('[data-juego]').hidden && !document.body.dataset.vioIgual && (await terminada())) agradecer();
        });
      });
    }
  }

  // ---------- Después de la ronda ----------
  // Pregunta al Worker si el operador ya pasó a otra ronda. Sin internet (o si tarda), se juega igual.
  // La Expo termina el 13/11 a las 21 (hora argentina): de ahí en más, sin preguntarle a nadie.
  // (La fecha va adentro: la función se llama más arriba, antes de que corra un const de acá abajo.)
  async function terminada() {
    if (Date.now() >= Date.parse('2026-11-13T21:00:00-03:00')) return true;
    try {
      const url = new URL(WORKER + '/bingo/ronda');
      url.searchParams.set('ronda', ronda);
      const r = await fetch(url, { signal: AbortSignal.timeout(4000) });
      return r.ok && !!(await r.json()).termino;
    } catch {
      return false;
    }
  }

  function agradecer() {
    $('[data-juego]').hidden = true;
    $('[data-gracias]').hidden = false;
    estado.textContent = `La ronda ${ronda} ya terminó`;
  }

  $('[data-ver-igual]').addEventListener('click', () => {
    document.body.dataset.vioIgual = '1'; // ya lo vio: no se lo volvemos a tapar
    $('[data-gracias]').hidden = true;
    if ($('[data-carton]').childElementCount) {
      $('[data-juego]').hidden = false;
      estado.textContent = `Tu cartón de la ronda ${ronda} (ya terminó)`;
    } else {
      // Nunca se dibujó: solo se puede mostrar el de papel o el que quedó guardado en el celular
      jugar().catch(() => (estado.textContent = 'Ese cartón ya no está en este celular.'));
    }
  });
</script>

<style>
  .hoja {
    max-width: 480px;
    margin: 0 auto;
    padding: 24px 16px 48px;
    display: grid;
    gap: 20px;
    text-align: center;
  }
  .etiqueta {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--suave);
