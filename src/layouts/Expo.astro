---
/**
 * El marco de las páginas de la Expo (src/pages/expo/): un diseño propio,
 * aparte del de las clases. Sin el menú del curso: quien llega por un QR del
 * stand no viene a cursar, viene a mirar treinta segundos.
 *
 * Oscuro siempre (en un salón iluminado y en una lona, el fondo oscuro cansa
 * menos), con las letras del sistema: nada que se baje de internet.
 */
interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0d1017" />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <title>{titulo}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --fondo: #0d1017;
    --superficie: #161b25;
    --borde: #262e3d;
    --texto: #eef1f6;
    --suave: #a3adbd;
    --oro: #f2c14e;
    --menta: #4fd1b5;
    --coral: #ff7a6b;
    --radio: 18px;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--menta);
  }
  img,
  svg {
    max-width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
